#!/usr/bin/env bash
# Print the last lines of a connected pane's screen without disturbing it.
set -euo pipefail
. "$(dirname "$0")/lib.sh"

FROM_PANE=""
[ "${1:-}" = "--from" ] && { FROM_PANE="${2:-}"; shift 2; }
case "${1:-}" in
  ''|-h|--help) echo "usage: tmux-peek [--from ME] <name> [lines]  (default 40)"; [ -n "${1:-}" ]; exit $? ;;
esac

require_tmux
ensure_agent_ids
self="$(self_pane)"
peer="$(find_pane "$1")"
case "$1" in %*) peer="$(resolve_pane "$1")" ;; esac
if [ -n "$peer" ] && [ "$(tmux show-option -pqv -t "$peer" @shell)" = 1 ]; then
  require_agent_pane "$self"
  pane_is_descendant "$peer" "$self" || die "'$1' is not your descendant shell"
else
  peer="$(resolve_peer "$self" "$1")"
fi
lines="${2:-40}"
case "$lines" in *[!0-9]*|'') die "lines must be a number" ;; esac

# Join wrapped lines, drop trailing blank lines, keep the last N.
tmux capture-pane -p -J -t "$peer" -S -500 \
  | awk '{ buf[NR] = $0 } NF { last = NR } END { for (i = 1; i <= last; i++) print buf[i] }' \
  | tail -n "$lines"
