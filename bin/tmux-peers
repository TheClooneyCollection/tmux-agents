#!/usr/bin/env bash
# Show this pane's name and the panes it is connected to.
set -euo pipefail
. "$(dirname "$0")/lib.sh"

FROM_PANE="" ids=0 refresh=0
while [ $# -gt 0 ]; do
  case "$1" in
    --from) FROM_PANE="${2:-}"; shift 2 ;;
    --ids) ids=1; shift ;;
    --refresh) refresh=1; shift ;;
    -h|--help) echo "usage: tmux-peers [--from ME] [--ids] [--refresh]"; exit 0 ;;
    *) die "unknown option: $1" ;;
  esac
done
# Hook refresh keeps its existing identity-independent path.
if [ "$refresh" = 1 ]; then require_tmux; refresh_labels; exit 0; fi

require_tmux
ensure_agent_ids
self="$(self_pane)"
name="$(pane_name "$self")"

if [ -z "$name" ]; then
  if trusted_pane; then
    name="$(auto_name "$self")" || die "couldn't give pane $self a name"
  else
    echo "This pane ($self) has no name and no connections."
    echo "Ask the user to run tmux-connect (or prefix + A) to connect it."
    exit 0
  fi
fi

if [ "$ids" = 1 ]; then echo "you: $name ($self) ID $(pane_agent_id "$self")"
else echo "you: $name ($self)"; fi
if [ -z "$FROM_PANE" ] && [ -z "${TMUX_AGENTS_PINNED:-}" ] && [ -z "${CLAUDECODE:-}" ]; then
  echo "warning: this comes from \$TMUX_PANE, which isn't pinned. Inside Codex it may be another agent's pane; don't assume this is you."
fi
closed="$(closed_names "$self")"
if [ -n "$closed" ]; then
  labels=""
  for aid in $closed; do
    label="$(agent_name_by_id "$aid")"
    [ -n "$label" ] || label='unknown agent'
    [ "$ids" != 1 ] || label="$label [$aid]"
    labels="${labels:+$labels, }$label"
  done
  echo "closed by user: $labels (reopen only if the user asks: tmux-spawn --resume NAME)"
fi
peers="$(get_peers "$self")"
if [ -z "$peers" ]; then
  echo "peers: none"
  exit 0
fi

{
  [ "$ids" != 1 ] || printf 'ID\t'
  printf 'NAME\tPANE\tCOMMAND\tWHERE\n'
  for peer in $peers; do
    [ "$ids" != 1 ] || printf '%s\t' "$(pane_agent_id "$peer")"
    printf '%s\t%s\t%s\t%s\n' "$(pane_name "$peer")" "$peer" "$(pane_command "$peer")" "$(pane_location "$peer")"
  done
} | column -t -s "$(printf '\t')"
