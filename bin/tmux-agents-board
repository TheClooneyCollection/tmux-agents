#!/usr/bin/env bash
# Read-only mission board; refreshes share the agent list's state and width logic.
set -euo pipefail
here="$(cd "${BASH_SOURCE[0]%/*}" && pwd)"
watch=0 interval=2 BOARD_ALL=0
usage() { echo 'usage: tmux-agents board [--all] [--watch [SECS]]'; }
while [ "$#" -gt 0 ]; do
  case "$1" in
    --help|-h) printf "%s\n" "$(usage)" 'Show the three most recently completed missions; --all expands earlier done missions.' 'Watch keys: a toggles all missions; q or Ctrl-C quits.'; exit 0 ;;
    --all) BOARD_ALL=1; shift ;;
    --watch) watch=1; shift
      if [ "$#" -gt 0 ] && [[ "$1" != --* ]]; then interval="$1"; shift; fi ;;
    *) usage >&2; exit 2 ;;
  esac
done
if ! [[ "$interval" =~ ^[0-9]+$ ]] || [ "$interval" -eq 0 ]; then
  usage >&2; echo 'interval must be positive whole seconds' >&2; exit 2
fi
export BOARD_ALL
if [ "$watch" = 1 ] && { [ ! -t 0 ] || [ ! -t 1 ]; }; then
  echo 'tmux-agents board: --watch requires a terminal' >&2; exit 2
fi
. "$here/lib.sh"
BOARD_MISSION_DIR="$(mission_directory)"
export BOARD_MISSION_DIR
BOARD_COLOR=0 BOARD_SPIN=0
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  BOARD_COLOR=1
  [ "$watch" = 0 ] || BOARD_SPIN=1
fi
export BOARD_COLOR BOARD_SPIN
# Resolve configuration once, before refreshes. Only snapshots run inside the loop.
if [ -z "${TMUX_AGENTS_PREFIX:-}" ]; then
  TMUX_AGENTS_PREFIX="$(tmux show-option -gqv @tmux_agents_session_prefix)" || TMUX_AGENTS_PREFIX=''
fi
export TMUX_AGENTS_PREFIX="${TMUX_AGENTS_PREFIX:-agents}"
# Keep path-to-project lookups across frames, private to this invocation.
project_cache="$(mktemp "${TMPDIR:-/tmp}/tmux-agents-board-projects.XXXXXX")"
export BOARD_PROJECT_CACHE="$project_cache"
terminal_state=''
# shellcheck disable=SC2329
restore() {
  rm -f "$project_cache"
  if [ -n "$terminal_state" ]; then stty "$terminal_state" <&3 || true; fi
  if [ "$watch" = 1 ]; then printf '\033[?25h'; fi
}
trap restore EXIT
if [ "$watch" = 1 ]; then
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap 'exit 129' HUP
  exec 3<&0
  terminal_state="$(stty -g <&3)"
  stty -icanon -echo min 1 time 0
  settings_get fps "" @tmux_agents_chip_fps 10
  case "$fps" in ''|*[!0-9]*) fps=10 ;; esac
  # Strip leading zeros before shell arithmetic (bash treats them as octal).
  fps="$(printf '%s' "$fps" | sed 's/^0*//')"
  fps=${fps:-0}
  if [ "${#fps}" -gt 2 ] || [ "$fps" -gt 30 ]; then fps=30; fi
  [ "$fps" -ge 1 ] || fps=1
  delay="$(awk -v f="$fps" 'BEGIN { printf "%.6f", 1 / f }')"
  frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
  spin=0
  printf '\033[?25l'
fi
# Paint the cached frame without invoking the renderer on animation ticks.
paint() {
  local line
  while IFS= read -r line; do
    printf '%s\033[K\n' "${line//$'\001'/${frames[$spin]}}"
  done <<<"$frame"
}
# Bash 3.2 read -t accepts only whole seconds; select supports chip-rate ticks.
watch_key() {
  perl -e '
    my $ready = "";
    vec($ready, fileno(STDIN), 1) = 1;
    if (select($ready, undef, undef, $ARGV[0]) > 0) {
      my $key;
      print $key if sysread(STDIN, $key, 1);
    }
  ' "$1"
}
while :; do
  if ! frame="$(perl "$here/tmux-agents-board.pl" "$here" 2>&1)"; then
    if [ "$watch" = 0 ]; then printf '%s\n' "$frame" >&2; exit 1; fi
    frame='board: refresh failed (retrying)'
  fi
  if [ "$watch" = 0 ]; then printf '%s\n' "$frame"; break; fi
  size="$( { stty size </dev/tty; } 2>/dev/null || stty size 2>/dev/null || true)"
  hint='a all missions · q quit'
  columns=${size##* }
  if [[ "$columns" =~ ^[0-9]+$ ]] && [ "$columns" -gt 0 ] && [ "$columns" -lt "${#hint}" ]; then
    # The hint uses single-cell characters; decode UTF-8 even in a C locale.
    hint="$(perl -CS -MEncode=decode -e 'print substr(decode("UTF-8", $ARGV[1]), 0, $ARGV[0])' "$columns" "$hint")"
  fi
  if [ "$BOARD_COLOR" = 1 ]; then hint=$'\033[2m'"$hint"$'\033[0m'; fi
  frame+=$'\n'"$hint"
  # Replace the previous frame and its history; normal-screen output remains scrollable.
  printf '\033[H\033[2J\033[3J'
  paint
  spin=$(((spin + 1) % 10))
  printf '\033[J'
  # A trailing newline at the bottom row scrolls; animate only with room to spare.
  rows=${size%% *}
  line_count=0
  while IFS= read -r line; do line_count=$((line_count + 1)); done <<<"$frame"
  animate=0
  if [[ "$rows" =~ ^[0-9]+$ ]] && [ "$line_count" -lt "$rows" ] &&
      [ "$BOARD_SPIN" = 1 ] && [[ "$frame" == *$'\001'* ]]; then animate=1; fi
  if [ "$animate" = 0 ]; then
    case "$(watch_key "$interval")" in
      q) break ;;
      a) BOARD_ALL=$((1 - BOARD_ALL)) ;;
    esac
  else
    ticks=$((interval * fps))
    for ((tick=0; tick<ticks; tick++)); do
      case "$(watch_key "$delay")" in
        q) exit 0 ;;
        a) BOARD_ALL=$((1 - BOARD_ALL)); break ;;
      esac
      # The next data refresh paints the final tick.
      if [ "$tick" -lt "$((ticks - 1))" ]; then
        printf '\033[H'
        paint
        spin=$(((spin + 1) % 10))
      fi
    done
  fi
done
