#!/usr/bin/env bash
# Report what an agent is doing, for the sub agent chip (tmux-agents --chip).
set -euo pipefail
. "$(dirname "$0")/lib.sh"

usage() {
  cat <<'USAGE'
usage: tmux-agent-report [--from ME] "what you're doing now"
       tmux-agent-report [--from ME] --local "new local work"
       tmux-agent-report [--from ME] --local-done
       tmux-agent-report [--from ME] --waiting "what you're waiting for"
                     (background or another agent's work, never the user)
       tmux-agent-report --pane PANE --perm on|off   (Claude hooks)
       tmux-agent-report --pane PANE --turn-start|--turn-end   (Claude hooks)
       tmux-agent-report [--agent-id ID] --codex-notify JSON (Codex notify)

Agents call it when they start a task and at each major step, with a
short phrase ("reading map loader", "running import tests"). A user prompt
is local work for the turn it starts; it ends with that turn. Use --local
for user work that spans turns and --local-done, with no text, when it
finishes. Ordinary progress reports do not start an independent local
task. The chip above the status bar shows it next to the agent's name.

Hooks call --perm on when the agent is waiting for a permission answer
and --perm off when it moves on; the chip turns that agent red.
Codex sub agents get no hooks: they run with auto_review, so their
permission requests go to a review model, never to the user. When one
does need the user, it ends its turn without replying. --turn-end
catches that: a sub agent that ends a turn neither done, idle, nor
waiting on its own sub agents, requests, or its parent after a notice
is marked needs_you. Codex reports turn ends through notify. Launchers
pass the stable identity with internal --agent-id; older notify commands
resolve a known thread or a request header in the first message
("[request from X to NAME via tmux-ask]"). The thread id is stored on
the pane (@codex_thread) for later turns.
USAGE
}

FROM_PANE="" pane="" perm="" turn="" notify_json="" notify_agent_id="" waiting=0 save_work=0 local_work=0 local_done=0
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --agent-id) notify_agent_id="${2:-}"; shift 2 ;;
    --from) FROM_PANE="${2:-}"; shift 2 ;;
    --pane) pane="${2:-}"; shift 2 ;;
    --save-work) save_work=1; shift ;;
    --perm) perm="${2:-}"; shift 2 ;;
    # Codex sub agents spawned before hooks were dropped still call this.
    --codex-hook) cat >/dev/null 2>&1; exit 0 ;;
    --waiting) waiting=1; shift ;;
    --local) local_work=1; shift ;;
    --local-done) local_done=1; shift ;;
    --turn-start) turn=start; shift ;;
    --turn-end) turn=end; shift ;;
    --codex-notify) notify_json="${2:-}"; turn=end; shift 2 ;;
    -*) usage >&2; exit 1 ;;
    *) break ;;
  esac
done

# Validate user-facing work modes before identity or state mutations.
if [ $((local_work + local_done + waiting)) -gt 1 ] ||
   { [ $((local_work + local_done + waiting)) -gt 0 ] && [ -n "$turn$perm" ]; }; then
  usage >&2; exit 1
fi
if [ "$local_done" -eq 1 ]; then
  [ "$#" -eq 0 ] || { usage >&2; exit 1; }
elif [ -z "$turn$perm" ] && [ "$save_work" -eq 0 ]; then
  [ -n "$*" ] || { usage >&2; exit 1; }
fi
if [ $((local_work + local_done + waiting)) -gt 0 ] && [ "$save_work" -eq 1 ]; then
  usage >&2; exit 1
fi

# Classify complete protocol messages, never just their first line. Text
# outside matching markers belongs to the user, including after a wrapper.
prompt_kind() {
  /usr/bin/perl -MJSON::PP -e '
    local $/; my $j=eval { decode_json(<STDIN>) } || {};
    my @inputs=($j->{prompt} // "");
    my $kind="notice";
    for my $p (@inputs) {
      $p =~ s/\A\s+|\s+\z//g;
      if ($p =~ /\A<pasted_content id="([^"\r\n]+)">(.*?)<\/pasted_content id="\1">\z/s) { $p=$2; }
      $p =~ s/\A\s+|\s+\z//g;
      if (!length $p) { $kind="local"; last; }
      while (length $p) {
        if ($p =~ s/\A\[(request|reply|notice) from (\S+) to (\S+) via tmux-ask\]\r?\n.*?\[end of \1 from \2 to \3\]\s*//s) {
          $kind="message" if $1 ne "notice";
        } else { $kind="local"; last; }
      }
      last if $kind eq "local";
    }
    print $kind;
  '
}

# The turn-end decision (completion, waits, needs you) runs as one ledger
# operation under the request lock: tmux-request-state turn-end.

[ -z "$notify_json" ] || { tmux list-sessions >/dev/null 2>&1 || exit 0; }
ensure_agent_ids

# Codex notify: find the pane from the turn's messages, or by thread id.
if [ -n "$notify_json" ]; then
  tmux list-sessions >/dev/null 2>&1 || exit 0
  # One pass over the payload: routing fields, dedup digest, prompt kind
  # and the log excerpt. Unit separators keep empty fields in place.
  fields="$(printf '%s' "$notify_json" | /usr/bin/perl -MJSON::PP -MDigest::SHA=sha256_hex -e '
    local $/; my $raw = <STDIN>; my $j = eval { decode_json($raw) } || {};
    my $to = "";
    my @inputs = @{ $j->{"input-messages"} || [] };
    for my $m (@inputs) {
      if ($m =~ /\[(?:request|reply) from \S+ to (\S+) via tmux-ask\]/) { $to = $1; last }
    }
    # Codex names a new session in a side thread whose whole answer is
    # {"title": ...}; that is not the agent ending a turn.
    my $last = $j->{"last-assistant-message"} // "";
    my $t = $last =~ /^\s*\{/ ? eval { JSON::PP->new->decode($last) } : undef;
    my $type = $j->{type} // "";
    $type = "title" if ref $t eq "HASH" && exists $t->{title} && keys %$t == 1;
    my $key = $j->{"turn-id"} // $j->{turn_id};
    my $digest = sha256_hex(defined($key) ? ($j->{"thread-id"} // "")."\0".$key : JSON::PP->new->canonical->encode($j));
    # Classify complete protocol messages, never just their first line.
    my $kind = "notice";
    for my $p (@inputs) {
      $p =~ s/\A\s+|\s+\z//g;
      if ($p =~ /\A<pasted_content id="([^"\r\n]+)">(.*?)<\/pasted_content id="\1">\z/s) { $p = $2; }
      $p =~ s/\A\s+|\s+\z//g;
      if (!length $p) { $kind = "local"; last; }
      while (length $p) {
        if ($p =~ s/\A\[(request|reply|notice) from (\S+) to (\S+) via tmux-ask\]\r?\n.*?\[end of \1 from \2 to \3\]\s*//s) {
          $kind = "message" if $1 ne "notice";
        } else { $kind = "local"; last; }
      }
      last if $kind eq "local";
    }
    (my $words = $last) =~ s/\s+/ /g;
    print join("\x1f", $type, $j->{"thread-id"} // "", $to, $digest, $kind, substr($words, 0, 80));
  ' 2>/dev/null)" || exit 0
  IFS=$'\x1f' read -r type thread to notify_digest local_prompt last_words <<EOF
$fields
EOF
  [ "$type" = agent-turn-complete ] && [ -n "$thread" ] || exit 0
  notify_target=""
  if [ -n "$notify_agent_id" ]; then
    valid_agent_id "$notify_agent_id" || exit 0
    notify_target="$(find_pane_by_id "$notify_agent_id")"
    [ -n "$notify_target" ] || exit 0
    known="$(tmux show-options -pqv -t "$notify_target" @codex_thread)"
    [ -z "$known" ] || [ "$known" = "$thread" ] || exit 0
    known="$(record_get "$notify_agent_id" id)"
    [ -z "$known" ] || [ "$known" = "$thread" ] || exit 0
  fi
  # One line per turn end, to debug state changes: time thread to= last words.
  { mkdir -p "/tmp/tmux-agents-$(id -u)" && printf '%s %s to=%s %s\n' "$(date '+%F %T')" "$thread" "${to:--}" "${last_words:-}" \
      >> "/tmp/tmux-agents-$(id -u)/notify.log"; } 2>/dev/null || true
  pane="$(tmux list-panes -a -F '#{pane_id} #{@codex_thread}' | awk -v t="$thread" '$2 == t { print $1; exit }')"
  if [ -z "$pane" ]; then
    # A late notification from a closed conversation must not bind to a
    # new agent that has reused its label. Records also survive renames.
    for rec in "$(sessions_dir)"/*; do
      if [ ! -f "$rec" ] || ! valid_agent_id "${rec##*/}"; then continue; fi
      [ "$(record_get "${rec##*/}" id)" = "$thread" ] || continue
      pane="$(find_pane_by_id "${rec##*/}")"
      [ -n "$pane" ] || exit 0
      [ -z "$notify_target" ] || [ "$pane" = "$notify_target" ] || exit 0
      tmux set-option -p -t "$pane" @codex_thread "$thread"
      break
    done
  fi
  if [ -n "$notify_agent_id" ]; then
    # The launcher has no request header on its first ordinary turn. Bind
    # only its stable identity, never a reused pane or display label.
    [ -z "$pane" ] || [ "$pane" = "$notify_target" ] || exit 0
    tmux set-option -p -t "$notify_target" @codex_thread "$thread"
    pane="$notify_target"
  fi
  if [ -z "$pane" ] && [ -n "$to" ]; then
    p="$(find_pane "$to")"
    if [ -n "$p" ] && [ -z "$(tmux show-options -pqv -t "$p" @codex_thread)" ]; then
      known="$(record_get "$(pane_agent_id "$p")" id)"
      [ -n "$known" ] && [ "$known" != "$thread" ] || tmux set-option -p -t "$p" @codex_thread "$thread"
    fi
  fi
  pane="$(tmux list-panes -a -F '#{pane_id} #{@codex_thread}' | awk -v t="$thread" '$2 == t { print $1; exit }')"
  [ -n "$pane" ] || exit 0
  # The thread id is the session id: record it so the sub agent can be
  # reopened once closed (tmux-spawn --resume).
  n="$(pane_agent_id "$pane")"
  if [ -n "$n" ] && [ -f "$(sessions_dir)/$n" ] && [ "$(record_get "$n" id)" != "$thread" ]; then
    record_set "$n" id "$thread"
  fi
fi

require_tmux
if [ -n "$pane" ]; then
  pane_alive "$pane" || exit 0
else
  pane="$(self_pane)"
fi

[ "$(tmux show-option -pqv -t "$pane" @shell)" != 1 ] || exit 0

[ "$save_work" -eq 0 ] || { agent_save_work "$pane"; exit 0; }

# Turn hooks prove tracking even when configured outside the launcher.
[ -z "$turn" ] || tmux set-option -p -t "$pane" @tracked 1

case "$turn" in
  end)
    if [ -n "$notify_json" ]; then
      request_state turn-end "$pane" "$notify_digest" "$local_prompt"
    else
      request_state turn-end "$pane"
    fi
    exit 0 ;;

  start)
    # A notice (tmux-ask --notice) asks for nothing, so it doesn't start new
    # work: keep what the agent is waiting on, and a needs-you stays one.
    # Claude passes the prompt to the hook as JSON on stdin.
    if [ ! -t 0 ]; then
      prompt="$(prompt_kind)"
      [ "$prompt" != notice ] || exit 0
    fi
    request_state progress "$pane"
    [ "${prompt:-local}" != local ] || request_state local "$pane"
    if [ "$(tmux show-options -pqv -t "$pane" @state)" = needs_you ]; then
      tmux set-option -pu -t "$pane" @attention_since 2>/dev/null || true
    fi
    agent_turn_state "$pane" start
    if [ "${prompt:-local}" = local ]; then request_state wait "$pane" ""; fi
    exit 0 ;;
esac

case "$perm" in
  on)
    agent_set_wait "$pane" perm "$(date +%s)"
    exit 0 ;;
  off)
    agent_set_wait "$pane" perm ""
    exit 0 ;;
esac

if [ "$local_done" -eq 1 ]; then
  request_state local-done "$pane"
  request_finish "$pane" || true
  exit 0
fi
request_state progress "$pane"
if [ "$local_work" -eq 1 ]; then request_state local "$pane" explicit; agent_set_state "$pane" working; fi
text="$*"
[ -n "$text" ] || { usage >&2; exit 1; }
text="$(printf '%s' "$text" | tr '\n\t' '  ' | cut -c1-60)"
if [ "$waiting" -eq 1 ]; then
  # Ending the turn to wait for background work: not a "needs you".
  request_state wait "$pane" "$text"
  text="waiting for $text"
else
  request_state wait "$pane" ""
fi
tmux set-option -p -t "$pane" @activity "$text"
# A report after replying ("delivered abc123") is a summary, not new work:
# a done agent stays done. A request or explicit --local starts new work.
agent_report_state "$pane"
tmux set-option -pu -t "$pane" @attention_since 2>/dev/null || true
echo "reported: $text"
