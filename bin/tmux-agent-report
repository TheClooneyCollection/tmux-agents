#!/usr/bin/env bash
# Report what an agent is doing, for the sub agent chip (tmux-agents --chip).
set -euo pipefail
. "$(dirname "$0")/lib.sh"

usage() {
  cat <<'USAGE'
usage: tmux-agent-report [--from ME] "what you're doing now"
       tmux-agent-report [--from ME] --needs-you "reason"
       tmux-agent-report --pane PANE --perm on|off
       tmux-agent-report --pane PANE --tool-start|--tool-end|--asking
       tmux-agent-report --pane PANE --turn-start|--turn-end
       tmux-agent-report [--agent-id ID] --codex-notify JSON

Progress reports start work. Turn ends show idle (top level) or done (sub
agent). --needs-you preserves attention until a non-notice turn or report.
Legacy --waiting and --local are progress reports; --local-done is a no-op.
USAGE
}

FROM_PANE="" pane="" perm="" tool="" turn="" notify_json="" notify_agent_id="" waiting=0 save_work=0 local_work=0 local_done=0 needs_you=0
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --agent-id) notify_agent_id="${2:-}"; shift 2 ;;
    --from) FROM_PANE="${2:-}"; shift 2 ;;
    --pane) pane="${2:-}"; shift 2 ;;
    --save-work) save_work=1; shift ;;
    --perm) perm="${2:-}"; shift 2 ;;
    --tool-start) tool=start; shift ;;
    --tool-end) tool=end; shift ;;
    --asking) tool=ask; shift ;;
    # Codex sub agents spawned before hooks were dropped still call this.
    --codex-hook) cat >/dev/null 2>&1; exit 0 ;;
    --needs-you) needs_you=1; shift ;;
    --waiting) waiting=1; shift ;;
    --local) local_work=1; shift ;;
    --local-done) local_done=1; shift ;;
    --turn-start) turn=start; shift ;;
    --turn-end) turn=end; shift ;;
    --codex-notify) notify_json="${2:-}"; turn=end; shift 2 ;;
    -*) usage >&2; exit 1 ;;
    *) break ;;
  esac
done

# Validate user-facing work modes before identity or state mutations.
if [ $((local_work + local_done + waiting + needs_you)) -gt 1 ] ||
   { [ $((local_work + local_done + waiting + needs_you)) -gt 0 ] && [ -n "$turn$perm$tool" ]; }; then
  usage >&2; exit 1
fi

if [ "$local_done" -eq 1 ]; then
  [ "$#" -eq 0 ] || { usage >&2; exit 1; }
  echo 'tmux-agent-report: --local-done is no longer needed' >&2
  exit 0
fi
if [ "$local_work" -eq 1 ]; then echo 'tmux-agent-report: --local is deprecated; reporting progress' >&2; fi
if [ "$waiting" -eq 1 ]; then echo 'tmux-agent-report: --waiting is deprecated; reporting progress' >&2; fi

# Tool hooks fire on every tool call: settle the common case (nothing to
# clear) with one tmux call, before identity checks or the accounting lock.
if [ -n "$tool" ]; then
  [ -n "$pane" ] || { usage >&2; exit 1; }
  asking=0
  [ "$tool" != ask ] || asking=1
  if [ "$tool" = start ] && [ ! -t 0 ]; then
    payload=""
    IFS= read -r -d '' payload || true
    # Claude writes compact JSON with tool_name before tool_input. Quotes
    # inside string values are escaped, so the first match is the key.
    case "$payload" in
      *'"tool_name":"AskUserQuestion"'*)
        rest="${payload#*\"tool_name\":\"}"
        [ "${rest%%\"*}" != AskUserQuestion ] || asking=1 ;;
    esac
  fi
  marks="$(tmux display-message -p -t "$pane" '#{@perm_since}|#{@asking}|#{@state}|#{@tracked}|#{@turn_began}' 2>/dev/null)" || exit 0
  # Not a tab: read would merge empty whitespace-separated fields.
  IFS='|' read -r perm_since was_asking state tracked turn_began <<< "$marks" || true
  if [ "$tool" = start ] && [ "$tracked" = 1 ] &&
      { [ "$state" = idle ] || [ "$state" = "done" ] || [ -z "$turn_began" ]; }; then
    turn_begin "$pane" message tool
  fi
  [ "$asking" -eq 1 ] || [ -n "$perm_since$was_asking" ] || exit 0
  if [ -n "$perm_since" ]; then
    agent_set_wait "$pane" perm ""
    if [ "$state" = needs_you ] && [ "$was_asking" != 1 ] &&
        [ "$(tmux show-option -pqv -t "$pane" @explicit_needs_you)" != 1 ]; then
      agent_set_state "$pane" working
      state=working
    fi
  fi
  if [ "$asking" -eq 1 ]; then
    # A question or elicitation blocks on the user like a permission dialog. Mark that this
    # hook set needs_you, so only the answer undoes it, never earlier attention.
    [ "$state" != needs_you ] || exit 0
    tmux set-option -p -t "$pane" @asking 1 \; set-option -p -t "$pane" @attention_since "$(date +%s)"
    agent_set_state "$pane" needs_you
  elif [ "$was_asking" = 1 ]; then
    tmux set-option -pu -t "$pane" @asking
    if [ "$state" = needs_you ] && [ "$(tmux show-option -pqv -t "$pane" @explicit_needs_you)" != 1 ]; then
      agent_set_state "$pane" working
    fi
  fi
  exit 0
fi

if [ "$local_done" -eq 1 ]; then
  [ "$#" -eq 0 ] || { usage >&2; exit 1; }
elif [ -z "$turn$perm" ] && [ "$save_work" -eq 0 ]; then
  [ -n "$*" ] || { usage >&2; exit 1; }
fi
if [ $((local_work + local_done + waiting + needs_you)) -gt 0 ] && [ "$save_work" -eq 1 ]; then
  usage >&2; exit 1
fi

# Classify complete protocol messages, never just their first line. Text
# outside matching markers belongs to the user, including after a wrapper.
prompt_kind() {
  /usr/bin/perl -MJSON::PP -e '
    local $/; my $j=eval { decode_json(<STDIN>) } || {};
    my @inputs=($j->{prompt} // "");
    my $kind="notice";
    for my $p (@inputs) {
      $p =~ s/\A\s+|\s+\z//g;
      if ($p =~ /\A<pasted_content id="([^"\r\n]+)">(.*?)<\/pasted_content id="\1">\z/s) { $p=$2; }
      $p =~ s/\A\s+|\s+\z//g;
      if (!length $p) { $kind="local"; last; }
      while (length $p) {
        if ($p =~ s/\A\[(request|reply|notice) from (\S+) to (\S+) via tmux-ask(?: \x{b7} m[0-9a-f]{12})?\]\r?\n.*?\[end of \1 from \2 to \3\]\s*//s) {
          $kind="message" if $1 ne "notice";
        } else { $kind="local"; last; }
      }
      last if $kind eq "local";
    }
    print $kind;
  '
}

[ -z "$notify_json" ] || { tmux list-sessions >/dev/null 2>&1 || exit 0; }
ensure_agent_ids
[ -n "$perm" ] || migrate_turn_state

# Codex notify: find the pane from the turn's messages, or by thread id.
if [ -n "$notify_json" ]; then
  tmux list-sessions >/dev/null 2>&1 || exit 0
  # One pass over the payload: routing fields
  # and the log excerpt. Unit separators keep empty fields in place.
  fields="$(printf '%s' "$notify_json" | /usr/bin/perl -MJSON::PP -e '
    local $/; my $raw = <STDIN>; my $j = eval { decode_json($raw) } || {};
    my $to = "";
    my @inputs = @{ $j->{"input-messages"} || [] };
    for my $m (@inputs) {
      if ($m =~ /\[(?:request|reply|notice) from \S+ to (\S+) via tmux-ask(?: \x{b7} m[0-9a-f]{12})?\]/) { $to = $1; last }
    }
    # Codex names a new session in a side thread whose whole answer is
    # {"title": ...}; that is not the agent ending a turn.
    my $last = $j->{"last-assistant-message"} // "";
    my $t = $last =~ /^\s*\{/ ? eval { JSON::PP->new->decode($last) } : undef;
    my $type = $j->{type} // "";
    $type = "title" if ref $t eq "HASH" && exists $t->{title} && keys %$t == 1;
    (my $words = $last) =~ s/\s+/ /g;
    print join("\x1f", $type, $j->{"thread-id"} // "", $to, substr($words, 0, 80));
  ' 2>/dev/null)" || exit 0
  IFS=$'\x1f' read -r type thread to last_words <<EOF
$fields
EOF
  [ "$type" = agent-turn-complete ] && [ -n "$thread" ] || exit 0
  notify_target=""
  if [ -n "$notify_agent_id" ]; then
    valid_agent_id "$notify_agent_id" || exit 0
    notify_target="$(find_pane_by_id "$notify_agent_id")"
    [ -n "$notify_target" ] || exit 0
    known="$(tmux show-options -pqv -t "$notify_target" @codex_thread)"
    [ -z "$known" ] || [ "$known" = "$thread" ] || exit 0
    known="$(record_get "$notify_agent_id" id)"
    [ -z "$known" ] || [ "$known" = "$thread" ] || exit 0
  fi
  # One line per turn end, to debug state changes: time thread to= last words.
  { mkdir -p "/tmp/tmux-agents-$(id -u)" && printf '%s %s to=%s %s\n' "$(date '+%F %T')" "$thread" "${to:--}" "${last_words:-}" \
      >> "/tmp/tmux-agents-$(id -u)/notify.log"; } 2>/dev/null || true
  pane="$(tmux list-panes -a -F '#{pane_id} #{@codex_thread}' | awk -v t="$thread" '$2 == t { print $1; exit }')"
  if [ -z "$pane" ]; then
    # A late notification from a closed conversation must not bind to a
    # new agent that has reused its label. Records also survive renames.
    for rec in "$(sessions_dir)"/*; do
      if [ ! -f "$rec" ] || ! valid_agent_id "${rec##*/}"; then continue; fi
      [ "$(record_get "${rec##*/}" id)" = "$thread" ] || continue
      pane="$(find_pane_by_id "${rec##*/}")"
      if [ -n "$notify_target" ]; then
        # A fresh launcher identity may resume a closed conversation. Its
        # verified live ID outranks closed records with no live pane,
        # but every live record owner must still agree with that identity.
        if [ -z "$pane" ]; then
          [ -n "$(record_get "${rec##*/}" closed)" ] || exit 0
        else
          [ "$pane" = "$notify_target" ] || exit 0
        fi
        continue
      fi
      [ -n "$pane" ] || exit 0
      tmux set-option -p -t "$pane" @codex_thread "$thread"
      break
    done
  fi
  if [ -n "$notify_agent_id" ]; then
    # The launcher has no request header on its first ordinary turn. Bind
    # only its stable identity, never a reused pane or display label.
    [ -z "$pane" ] || [ "$pane" = "$notify_target" ] || exit 0
    tmux set-option -p -t "$notify_target" @codex_thread "$thread"
    pane="$notify_target"
  fi
  if [ -z "$pane" ] && [ -n "$to" ]; then
    p="$(find_pane "$to")"
    if [ -n "$p" ] && [ -z "$(tmux show-options -pqv -t "$p" @codex_thread)" ]; then
      known="$(record_get "$(pane_agent_id "$p")" id)"
      [ -n "$known" ] && [ "$known" != "$thread" ] || tmux set-option -p -t "$p" @codex_thread "$thread"
    fi
  fi
  pane="$(tmux list-panes -a -F '#{pane_id} #{@codex_thread}' | awk -v t="$thread" '$2 == t { print $1; exit }')"
  [ -n "$pane" ] || exit 0
  # The thread id is the session id: record it so the sub agent can be
  # reopened once closed (tmux-spawn --resume).
  n="$(pane_agent_id "$pane")"
  if [ -n "$n" ] && [ -f "$(sessions_dir)/$n" ] && [ "$(record_get "$n" id)" != "$thread" ]; then
    record_set "$n" id "$thread"
  fi
fi

require_tmux
if [ -n "$pane" ]; then
  pane_alive "$pane" || exit 0
else
  pane="$(self_pane)"
fi

if [ "$needs_you" -eq 1 ]; then
  [ "$(tmux show-option -pqv -t "$pane" @shell)" != 1 ] &&
    [ "$(tmux show-option -pqv -t "$pane" @tracked)" = 1 ] || {
      echo "tmux-agent-report: --needs-you requires a tracked agent" >&2; exit 1;
    }
  text="$(printf '%s' "$*" | tr '\n\t' '  ' | cut -c1-60)"
  [ -n "${text//[[:space:]]/}" ] || { usage >&2; exit 1; }
  turn_needs_you "$pane" "$text"
  # A top-level agent may be the first pane requiring a chip on this server.
  "$(dirname "$0")/tmux-agents" --chip-layout on >/dev/null 2>&1 || true
  echo "needs you: $text"
  exit 0
fi

[ "$(tmux show-option -pqv -t "$pane" @shell)" != 1 ] || exit 0

[ "$save_work" -eq 0 ] || { agent_save_work "$pane"; exit 0; }

# Turn hooks prove tracking even when configured outside the launcher.
# Notice turns preserve question provenance until an answer or non-notice start.
[ -z "$turn" ] || tmux set-option -p -t "$pane" @tracked 1

case "$turn" in
  end)
    stopped="$(turn_end "$pane" "$notify_json")"
    if [ -n "$stopped" ]; then
      me="$(pane_name "$pane")" doing="$(tmux show-option -pqv -t "$pane" @activity)"
      "$(dirname "$0")/tmux-ask" --system-notice "$stopped" \
        "${me:-$pane} stopped without replying to your last request: ${doing:-no report yet}" tmux-agents \
        </dev/null >/dev/null 2>&1 || true
    fi
    exit 0 ;;
  start)
    prompt=local
    if [ ! -t 0 ]; then prompt="$(prompt_kind)"; fi
    turn_begin "$pane" "$prompt" prompt
    exit 0 ;;
esac

case "$perm" in
  on)
    agent_set_wait "$pane" perm "$(date +%s)"
    exit 0 ;;
  off)
    perm_since="$(tmux show-option -pqv -t "$pane" @perm_since)"
    agent_set_wait "$pane" perm ""
    if [ -n "$perm_since" ] && [ "$(tmux show-option -pqv -t "$pane" @state)" = needs_you ] &&
        [ "$(tmux show-option -pqv -t "$pane" @explicit_needs_you)" != 1 ] &&
        [ "$(tmux show-option -pqv -t "$pane" @asking)" != 1 ]; then
      agent_set_state "$pane" working
    fi
    exit 0 ;;
esac

text="$*"
[ -n "$text" ] || { usage >&2; exit 1; }
text="$(printf '%s' "$text" | tr '\n\t' '  ' | cut -c1-60)"
tmux set-option -p -t "$pane" @activity "$text"
turn_progress "$pane"
echo "reported: $text"
