#!/usr/bin/env bash
# Start a sub agent in a hidden window or visible split, connected to its owner.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
. "$here/lib.sh"

settings_get MAX_DEPTH TMUX_AGENTS_MAX_DEPTH @tmux_agents_max_depth 2

usage() {
  cat <<'EOF'
usage: tmux-spawn [claude|codex|PROFILE] [--from ME] [--name NAME] [--exact] [task...]
       tmux-spawn [claude|codex|PROFILE] --for OWNER [--from ME] [--name NAME] [--exact] [brief...]
       tmux-spawn [claude|codex|PROFILE] --split PANE [--right | --below] [--size N%] [task...]
       tmux-spawn --resume NAME | --resume-id ID [--from ME | --parent NAME]
       tmux-spawn --list-closed

By default, starts a sub agent in its own window of the project's hidden session
(agents-<project>), names it, connects it to this pane, and hands it
the task (arguments, or stdin if none) as a tmux-ask request. It
replies with tmux-ask --reply when done. The agent defaults to the
same kind as the caller, in auto mode (Claude --permission-mode auto,
Codex approvals_reviewer=auto_review).

  --from ME     your own name (needed where $TMUX_PANE is wrong, e.g. Codex)
  --name NAME   short task name, e.g. auth-review, becomes <agent>-<dir>-NAME;
                an existing prefix is kept; clashes add -2, -3...
                profiles use codex as <agent>, home uses ~ as <dir>
                (without --name: <agent>-<dir>-<N>)
  --exact       use --name verbatim, without its agent/directory prefix
  --for OWNER   spawn it for OWNER, an agent you're connected to: it becomes
                OWNER's sub agent, connected to OWNER only, and starts without
                a task. OWNER is told, with your brief, and sends the first
                task itself. Depth still counts from you.
  --split PANE  open in a visible split of an agent name or pane id
  --right       split left/right (default); the new pane is on the right
  --below       split top/bottom; the new pane is below
  --size N%     new pane share, 1% to 99% (default 50%)
  --resume NAME reopen a closed sub agent with its conversation, in the
                same project in a hidden window, connected to you (or to --parent);
                ambiguous names require --resume-id; live clashes add -2, -3...
  --resume-id ID reopen one exact closed agent identity
  --list-closed  list resumable identities, names, closed times, parents and projects

Each sub agent's session is recorded (see sessions_dir in lib.sh), so a
closed one can be reopened. Codex records it when its first turn ends.

Given-name format: --exact overrides TMUX_AGENTS_NAME_FORMAT, then the tmux
option @tmux_agents_name_format (exact or prefixed; default prefixed).

Browse agents with tmux-agents (prefix + a).

Settings (environment overrides option):
  accounts: option @tmux_agents_codex_homes, env TMUX_AGENTS_CODEX_HOMES
    PROFILE=CODEX_HOME pairs, e.g. "work=$HOME/.codex-work" (no spaces in paths);
    default none; legacy tmux global environment is the final fallback
  name format: option @tmux_agents_name_format, env TMUX_AGENTS_NAME_FORMAT
    exact or prefixed (default prefixed); --exact wins for one call
  depth: option @tmux_agents_max_depth, env TMUX_AGENTS_MAX_DEPTH (default 2)
  sessions: option @tmux_agents_session_prefix, env TMUX_AGENTS_PREFIX (agents)
Test hook: TMUX_SPAWN_BIN puts a directory first on the agent's PATH.
EOF
}

# Keep resolved settings separate from explicit environment overrides. Legacy
# tmux global environment remains the final profile fallback.
settings_get codex_homes TMUX_AGENTS_CODEX_HOMES @tmux_agents_codex_homes ""
if [ -z "$codex_homes" ] && [ -n "${TMUX:-}" ]; then
  v="$(tmux show-environment -g TMUX_AGENTS_CODEX_HOMES 2>/dev/null || true)"
  case "$v" in TMUX_AGENTS_CODEX_HOMES=?*) codex_homes="${v#*=}" ;; esac
fi

codex_home_for() {
  local e
  for e in $codex_homes; do
    [ "${e%%=*}" != "$1" ] || { printf '%s\n' "${e#*=}"; return 0; }
  done
  return 1
}

codex_profile_for_home() {
  local e
  for e in $codex_homes; do
    [ "${e#*=}" != "$1" ] || { printf '%s\n' "${e%%=*}"; return 0; }
  done
  return 1
}

# Inside the new pane: start the agent with the task as its first prompt.
if [ "${1:-}" = "--run" ]; then
  agent="$2" file="$3" sid="${4:-}" mode="${5:-new}"
  # Preserve the caller's resolution across tmux's global-env inheritance.
  codex_homes="${TMUX_SPAWN_CODEX_HOMES-$codex_homes}"
  unset TMUX_SPAWN_CODEX_HOMES
  prompt=""
  [ -z "$file" ] || { prompt="$(cat "$file")"; rm -f "$file"; }
  export PATH="$here:$PATH"
  # Test hook: put stand-in agent binaries first.
  [ -z "${TMUX_SPAWN_BIN:-}" ] || export PATH="$TMUX_SPAWN_BIN:$PATH"
  # Codex runs commands in a shared app-server daemon that keeps the env of
  # whichever pane started it; pin this pane's identity for its commands.
  codex_env=(
    -c "shell_environment_policy.set.TMUX_PANE=\"${TMUX_PANE:-}\""
    -c "shell_environment_policy.set.TMUX=\"${TMUX:-}\""
    -c "shell_environment_policy.set.TMUX_AGENTS_DEPTH=\"${TMUX_AGENTS_DEPTH:-0}\""
    -c 'shell_environment_policy.set.TMUX_AGENTS_PINNED="1"'
    -c "shell_environment_policy.set.TMUX_AGENTS_KIND=\"$agent\""
  )
  # Sub agents start in auto mode: Claude's auto permission mode, Codex's
  # auto review, so the user isn't asked about every command they run.
  # Permission hooks feed the chip: an agent waiting for approval can't
  # report anything itself. Claude runs hooks in its own process, so its
  # commands can carry the pane id.
  report="'$here/tmux-agent-report' --pane '${TMUX_PANE:-}'"
  claude_hooks="$(printf '{"hooks":{"Notification":[{"matcher":"permission_prompt","hooks":[{"type":"command","command":"%s --perm on"}]}],"PostToolUse":[{"hooks":[{"type":"command","command":"%s --perm off"}]}],"UserPromptSubmit":[{"hooks":[{"type":"command","command":"%s --turn-start"}]}],"Stop":[{"hooks":[{"type":"command","command":"%s --turn-end"}]}]}}' "$report" "$report" "$report" "$report")"
  # Codex says when a turn ends through notify (not a hook, so no trust
  # prompt); tmux-agent-report finds the pane from the turn's messages.
  codex_notify=(-c "notify=[\"$here/tmux-agent-report\",\"--codex-notify\"]")
  # A new Claude gets the session id we recorded; --resume reopens one.
  case "$agent" in
    claude)
      cmd=(claude --permission-mode auto --settings "$claude_hooks")
      if [ "$mode" = resume ]; then cmd+=(--resume "$sid"); elif [ -n "$sid" ]; then cmd+=(--session-id "$sid"); fi ;;
    # No hooks for Codex: with auto_review its escalations go to a review
    # model, never to the user, so PermissionRequest only ever misfired.
    *)
      if [ "$agent" != codex ]; then
        home="$(codex_home_for "$agent")" || die "unknown agent '$agent' (claude, codex, or a TMUX_AGENTS_CODEX_HOMES profile)"
        export CODEX_HOME="$home"
      fi
      cmd=(codex)
      [ "$mode" != resume ] || cmd+=(resume)
      cmd+=(-c 'approvals_reviewer="auto_review"' "${codex_env[@]}" "${codex_notify[@]}")
      [ "$mode" != resume ] || cmd+=("$sid") ;;
  esac
  if [ -n "$prompt" ]; then exec "${cmd[@]}" "$prompt"; else exec "${cmd[@]}"; fi
fi

agent="" name="" task="" FROM_PANE="" resume="" resume_id="" list_closed=0 parent_name="" for_name=""
exact=0 name_given=0
split_target="" split_pane="" split_direction="" split_size="50%" split_options=0
case "${1:-}" in
  claude|codex) agent="$1"; shift ;;
  -*|'') ;;
  *) if codex_home_for "$1" >/dev/null; then agent="$1"; shift; fi ;;
esac
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --name)
      [ -n "${2:-}" ] || die "--name needs a name"
      name="$2"; name_given=1; shift 2 ;;
    --exact) exact=1; shift ;;
    --from) FROM_PANE="${2:-}"; shift 2 ;;
    --resume) [ -n "${2:-}" ] || die "--resume needs a name"; resume="$2"; shift 2 ;;
    --resume-id) [ -n "${2:-}" ] || die "--resume-id needs an id"; resume_id="$2"; shift 2 ;;
    --list-closed) list_closed=1; shift ;;
    --parent) parent_name="${2:-}"; shift 2 ;;
    --for) for_name="${2:-}"; shift 2 ;;
    --split)
      [ -n "${2:-}" ] || die "--split needs an agent name or pane id"
      split_target="$2"; shift 2 ;;
    --right|--below)
      [ -z "$split_direction" ] || die "choose only one of --right and --below"
      split_direction="$1"; split_options=1; shift ;;
    --size)
      [ -n "${2:-}" ] || die "--size needs a percentage (1% to 99%)"
      split_size="$2"; split_options=1; shift 2 ;;
    --) shift; task="$*"; break ;;
    -*) usage >&2; exit 1 ;;
    *) task="$*"; break ;;
  esac
done
[ -z "$resume" ] || [ -z "$resume_id" ] || die "choose --resume or --resume-id"
[ -z "$resume$resume_id" ] || { [ "$name_given" -eq 0 ] && [ "$exact" -eq 0 ]; } || die "--resume keeps its recorded name; --name and --exact are only for new sub agents"
[ "$exact" -eq 0 ] || [ "$name_given" -eq 1 ] || die "--exact requires --name"
[ "$split_options" -eq 0 ] || [ -n "$split_target" ] || die "--right, --below and --size require --split"
[ -z "$resume$resume_id" ] || [ -z "$split_target" ] || die "--resume reopens hidden; --split is only for new sub agents"
size_re='^([1-9]|[1-9][0-9])%$'
[[ $split_size =~ $size_re ]] || die "--size must be a percentage from 1% to 99%"
[ "$list_closed" -eq 1 ] || [ -n "$resume$resume_id" ] || [ -n "$task" ] || [ -t 0 ] || task="$(cat)"

require_tmux
ensure_agent_ids

# Show a sub agent's pane, connected to its parent ($2, may be empty), and
# keep its transcript on screen after the agent exits.
adopt() {
  tmux set-option -p -t "$1" remain-on-exit on
  [ "${4:-hidden}" = split ] || tmux set-option -w -t "$1" automatic-rename off
  set_name "$1" "$3"
  if [ -n "$2" ]; then
    tmux set-option -p -t "$1" @parent "$2"
    add_peer "$2" "$1"
    add_peer "$1" "$2"
  fi
  refresh_labels
  # Show the sub agent chip line above the status bar.
  "$here/tmux-agents" --chip-layout on
}

# Open a new window for a sub agent in session $1, directory $2, name $3,
# running $4 with depth $5. Prints the pane id.
open_window() {
  local env_args=(-e "TMUX_AGENTS_DEPTH=$5" -e "TMUX_SPAWN_CODEX_HOMES=$codex_homes")
  [ -z "${TMUX_SPAWN_BIN:-}" ] || env_args+=(-e "TMUX_SPAWN_BIN=$TMUX_SPAWN_BIN")
  [ -z "${TMUX_AGENTS_CODEX_HOMES:-}" ] || env_args+=(-e "TMUX_AGENTS_CODEX_HOMES=$TMUX_AGENTS_CODEX_HOMES")
  if tmux has-session -t "=$1" 2>/dev/null; then
    tmux new-window -d -t "=$1:" -n "$3" -c "$2" "${env_args[@]}" -P -F '#{pane_id}' "$4"
  else
    tmux new-session -d -s "$1" -n "$3" -c "$2" "${env_args[@]}" -P -F '#{pane_id}' "$4"
  fi
}

# Split a resolved pane, leaving focus and the shared window options alone.
# Directory, command and environment match open_window.
open_split() {
  local direction=-h env_args=(-e "TMUX_AGENTS_DEPTH=$4" -e "TMUX_SPAWN_CODEX_HOMES=$codex_homes")
  [ "$split_direction" != --below ] || direction=-v
  [ -z "${TMUX_SPAWN_BIN:-}" ] || env_args+=(-e "TMUX_SPAWN_BIN=$TMUX_SPAWN_BIN")
  [ -z "${TMUX_AGENTS_CODEX_HOMES:-}" ] || env_args+=(-e "TMUX_AGENTS_CODEX_HOMES=$TMUX_AGENTS_CODEX_HOMES")
  tmux split-window -d "$direction" -l "$split_size" -t "$1" -c "$2" "${env_args[@]}" -P -F '#{pane_id}' "$3"
}

# Closed records are selected by identity, never by a live namesake.
closed_record() {
  [ -f "$(sessions_dir)/$1" ] && [ -z "$(find_pane_by_id "$1")" ]
}
closed_row() {
  local aid="$1" parent_id parent_label current_label
  parent_id="$(record_get "$aid" parent)"
  parent_label="$(record_get "$aid" parent_name)"
  if [ -n "$parent_id" ]; then
    current_label="$(agent_name_by_id "$parent_id")"
    [ -z "$current_label" ] || parent_label="$current_label"
  fi
  printf '%s\t%s\t%s\t%s\t%s\n' "$aid" "$(record_get "$aid" name)" \
    "$(record_get "$aid" closed)" "$parent_label" "$(record_get "$aid" dir)"
}
if [ "$list_closed" -eq 1 ]; then
  printf 'id\tname\tclosed\tparent\tproject\n'
  for f in "$(sessions_dir)"/*; do
    aid="${f##*/}"
    valid_agent_id "$aid" || continue
    closed_record "$aid" || continue
    [ -n "$(record_get "$aid" id)" ] || continue
    closed_row "$aid"
  done
  exit 0
fi
if [ -n "$resume$resume_id" ]; then
  if [ -n "$resume" ]; then
    matches=""
    for aid in $(record_ids_by_name "$resume"); do
      closed_record "$aid" || continue
      matches="${matches:+$matches }$aid"
    done
    [ -n "$matches" ] || die "no closed record of a sub agent named '$resume'"
    case "$matches" in *' '*)
      printf "Several closed agents are named '%s'; choose --resume-id:\n" "$resume" >&2
      for aid in $matches; do closed_row "$aid" >&2; done
      exit 1 ;;
    esac
    resume_id="$matches"
  fi
  valid_agent_id "$resume_id" || die "invalid agent id '$resume_id'"
  closed_record "$resume_id" || die "'$resume_id' has no closed record or is still open"
  resume="$(record_get "$resume_id" name)"
  kind="$(record_get "$resume_id" kind)" sid="$(record_get "$resume_id" id)"
  dir="$(record_get "$resume_id" dir)" rdepth="$(record_get "$resume_id" depth)"
  [ -n "$sid" ] || die "can't reopen '$resume': its session id was never recorded (Codex records it when its first turn ends)"
  [ -d "$dir" ] || die "can't reopen '$resume': its directory $dir is gone"
  # Validate an explicitly supplied caller even when restoring a live parent.
  [ -z "$FROM_PANE" ] || self_pane >/dev/null
  parent="" saved_parent="$(record_get "$resume_id" parent)"
  if [ -n "$saved_parent" ]; then parent="$(find_pane_by_id "$saved_parent")"; fi
  if [ -z "$parent" ]; then
    if [ -n "$parent_name" ]; then
      parent="$(find_pane "$parent_name")"
    elif [ -n "$FROM_PANE" ] || [ -n "${TMUX_PANE:-}" ]; then
      parent="$(self_pane)"
    fi
  fi
  resume="$(unique_name "$resume")"
  pane="$(open_window "$(agents_session_for "$dir")" "$dir" "$resume" \
    "'$here/tmux-spawn' --run '$kind' '' '$sid' resume" "${rdepth:-1}")"
  ensure_agent_id "$pane" "$resume_id" >/dev/null
  adopt "$pane" "$parent" "$resume"
  [ "$kind" = claude ] || tmux set-option -p -t "$pane" @codex_thread "$sid"
  tmux set-option -p -t "$pane" @state "done"
  record_set "$resume_id" name "$resume"
  record_set "$resume_id" closed ""
  if [ -n "$parent" ]; then
    remove_word "$parent" @closed "$resume_id"
    record_set "$resume_id" parent "$(ensure_agent_id "$parent")"
    record_set "$resume_id" parent_name "$(pane_name "$parent")"
    printf 'reopened %s (%s) with its conversation, connected to %s; send it the next task with tmux-ask.\n' "$resume" "$pane" "$(pane_name "$parent")"
  else
    printf 'reopened %s (%s) with its conversation; its parent is gone, so it is not connected to anyone.\n' "$resume" "$pane"
  fi
  "$here/tmux-ask" --retry --to "$resume"
  exit 0
fi

self="$(self_pane)"

if [ -n "$split_target" ]; then
  # Unlike general message targets, splits accept only exact names or pane ids.
  pane_id_re='^%[0-9]+$'
  [[ $split_target =~ $pane_id_re ]] || [ -n "$(find_pane "$split_target")" ] \
    || die "--split needs an existing agent name or pane id: '$split_target'"
  split_pane="$(resolve_pane "$split_target")"
fi

depth="${TMUX_AGENTS_DEPTH:-0}"
[ "$depth" -lt "$MAX_DEPTH" ] || die "spawn depth limit ($MAX_DEPTH) reached; do this task yourself"

# Default to the caller's own kind of agent. Codex's commands run in a
# shared daemon without its CODEX_HOME, so Codex started through tmux-spawn
# or the fish wrappers carries its kind in TMUX_AGENTS_KIND.
if [ -z "$agent" ]; then
  if [ -n "${TMUX_AGENTS_KIND:-}" ]; then
    agent="$TMUX_AGENTS_KIND"
  elif [ -n "${CLAUDECODE:-}" ]; then
    agent=claude
  elif [ -n "${CODEX_HOME:-}" ] && codex_profile_for_home "$CODEX_HOME" >/dev/null; then
    agent="$(codex_profile_for_home "$CODEX_HOME")"
  else
    case "$(pane_command "$self")" in
      *claude*) agent=claude ;;
      *codex*) agent=codex ;;
      *) die "can't tell which agent you are; pass claude, codex or a TMUX_AGENTS_CODEX_HOMES profile" ;;
    esac
  fi
fi

# The caller needs a name so the sub agent can reply to it.
me="$(pane_name "$self")"
if [ -z "$me" ]; then
  me="$(suggest_name "$self")"
  set_name "$self" "$me"
fi

# --for: the sub agent belongs to OWNER, which must be connected to us.
# It starts without a task; the brief goes to OWNER, who sends the first one.
owner="$self" owner_name="$me" brief=""
if [ -n "$for_name" ]; then
  owner="$(resolve_peer "$self" "$for_name")"
  [ "$owner" != "$self" ] || die "--for names you; spawn without it"
  owner_name="$(pane_name "$owner")"
  brief="$task" task=""
fi

cwd="$(tmux display-message -p -t "$self" '#{pane_current_path}')"
if [ -n "$name" ]; then
  kind=codex
  [ "$agent" != claude ] || kind=claude
  name="$(format_given_name "$kind" "$cwd" "$name" "$exact")"
  name="$(unique_name "$name")"
else
  name="$(name_for "$agent" "$cwd")"
fi
session="$(agents_session_for "$cwd")"

# Hand the prompt over in a file, so no shell ever has to quote it.
file="$(mktemp "${TMPDIR:-/tmp}/tmux-spawn.XXXXXX")"
# Ask for progress reports; the chip above the status bar shows them.
if [ -n "$task" ]; then
  task="$task

(Progress: when you start, and at each major step, run tmux-agent-report --from $name \"<what you're doing, a few words>\". It shows in the user's status bar.)"
  request_body "$me" "$task" "$name" > "$file"
fi
# Record the session so the sub agent can be reopened once closed. Claude
# takes the id we give it; Codex's is filled in when its first turn ends.
sid=""
if [ "$agent" = claude ]; then
  sid="$(uuidgen 2>/dev/null || cat /proc/sys/kernel/random/uuid)"
  sid="$(printf '%s' "$sid" | tr '[:upper:]' '[:lower:]')"
fi
agent_id="$(new_agent_id)"
record_set "$agent_id" name "$name"
record_set "$agent_id" kind "$agent"
record_set "$agent_id" id "$sid"
record_set "$agent_id" dir "$cwd"
record_set "$agent_id" parent "$(ensure_agent_id "$owner")"
record_set "$agent_id" parent_name "$owner_name"
record_set "$agent_id" depth "$((depth + 1))"

if [ -n "$split_pane" ]; then
  pane="$(open_split "$split_pane" "$cwd" "'$here/tmux-spawn' --run '$agent' '$file' '$sid'" "$((depth + 1))")"
  ensure_agent_id "$pane" "$agent_id" >/dev/null
  adopt "$pane" "$owner" "$name" split
  location="in a visible split of $split_pane"
else
  pane="$(open_window "$session" "$cwd" "$name" "'$here/tmux-spawn' --run '$agent' '$file' '$sid'" "$((depth + 1))")"
  ensure_agent_id "$pane" "$agent_id" >/dev/null
  adopt "$pane" "$owner" "$name"
  location="hidden in session \"$session\""
fi

if [ -z "$task" ]; then
  tmux set-option -p -t "$pane" @state idle
fi

if [ -n "$for_name" ]; then
  tmux set-option -p -t "$pane" @activity "waiting for its first task from $owner_name"
  msg="I spawned $name ($agent) for you: it is your sub agent now, connected to you (not to me), and it has no task yet. Introduce yourself to it (who you are, your role, how you'll work together), then send it its first task: tmux-ask --from $owner_name $name. It replies to you; close it with tmux-dismiss --from $owner_name $name when you're done with it."
  [ -z "$brief" ] || msg="$msg

My brief for it:
$brief"
  printf '%s\n' "$msg" | "$here/tmux-ask" --from "$self" "$owner_name" >/dev/null \
    || die "spawned $name ($pane) for $owner_name, but couldn't tell $owner_name; tell it yourself"
  printf 'spawned %s (%s) as %s for %s, %s. Told %s to introduce itself and send the first task; %s replies to %s, not to you. View: tmux-agents or prefix + a.\n' \
    "$agent" "$pane" "$name" "$owner_name" "$location" "$owner_name" "$name" "$owner_name"
  exit 0
fi

printf 'spawned %s (%s) as %s, %s; it will reply via tmux-ask. View: tmux-agents or prefix + a.\n' \
  "$agent" "$pane" "$name" "$location"
