#!/usr/bin/env bash
# Read quiet notes for the calling agent without delivering a prompt.
set -euo pipefail
# Statuslines explicitly trust their pane. Keep this before library loading and
# option parsing: one tmux query, then only shell builtins and immutable names.
if [ "$#" -eq 1 ] && [ "$1" = --count ]; then
  fast_notes_count() {
    local id sock dir cursor=0 padded file name prefix count=0
    if [ -z "${TMUX_PANE:-}" ] || [ -z "${TMUX:-}" ]; then printf '0\n'; return; fi
    id="$(tmux display-message -p -t "$TMUX_PANE" '#{@agent_id}' 2>/dev/null)" || id=''
    if [[ ! $id =~ ^a[0-9a-f]{12}$ ]]; then printf '0\n'; return; fi
    sock="${TMUX%%,*}"; sock="${sock##*/}"
    dir="${XDG_STATE_HOME:-$HOME/.local/state}/tmux-agents/${sock:-default}/notes/$id"
    if [ ! -d "$dir" ]; then printf '0\n'; return; fi
    if [ -f "$dir/.cursor" ]; then
      { IFS= read -r cursor < "$dir/.cursor"; } 2>/dev/null || true
    fi
    case "$cursor" in ''|*[!0-9]*) cursor=0 ;; esac
    [ "${#cursor}" -le 20 ] || { printf '0\n'; return; }
    padded="00000000000000000000$cursor"; padded="${padded: -20}"
    local LC_ALL=C
    for file in "$dir"/*.json; do
      [ -f "$file" ] || continue
      name="${file##*/}"
      [[ $name =~ ^[0-9]{20}-m[0-9a-f]+\.json$ ]] || continue
      prefix="${name%%-*}"
      if [[ $prefix > $padded ]]; then count=$((count + 1)); fi
    done
    printf '%s\n' "$count"
  }
  fast_notes_count
  exit 0
fi
here="$(cd "$(dirname "$0")" && pwd)"
. "$here/lib.sh"
. "$here/notes-lib.sh"
FROM_PANE="" all=0 keep=0 mode=read after=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --from) [ "$#" -ge 2 ] || die '--from needs a name'; FROM_PANE="$2"; shift 2 ;;
    --all) all=1; shift ;;
    --keep-unread) keep=1; shift ;;
    --count) mode=count; shift ;;
    --since)
      [ "$#" -ge 2 ] || die '--since needs a duration such as 10m or 2h'
      duration="$2"; amount="${duration%?}"
      case "$amount" in ''|*[!0-9]*) die 'invalid --since duration' ;; esac
      [ "${#amount}" -le 8 ] || die 'invalid --since duration'
      case "$duration" in *m) scale=60 ;; *h) scale=3600 ;; *) die 'invalid --since duration' ;; esac
      after=$(( $(date +%s) - 10#$amount * scale )); shift 2 ;;
    -h|--help)
      echo 'usage: tmux-notes [--from ME] [--all] [--since 10m|2h] [--keep-unread] [--count]'
      exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done
require_tmux
ensure_agent_ids
self="$(self_pane)"
require_agent_pane "$self"
id="$(ensure_agent_id "$self")"
# Count always means unread and never advances the read cursor.
if [ "$mode" = count ]; then all=0; keep=1; fi
_notes_store "$mode" "$id" "$after" "$all" "$keep" ''
