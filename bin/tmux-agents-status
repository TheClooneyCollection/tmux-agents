#!/usr/bin/env bash
# Read-only orientation. Only --notes advances the unread cursor.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
. "$here/lib.sh"
FROM_PANE='' peer='' notes=0 handoff=0 full=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --from) [ "$#" -ge 2 ] && [ -n "$2" ] || die '--from needs a name'; FROM_PANE="$2"; shift 2 ;;
    --notes) notes=1; shift ;;
    --handoff) handoff=1; shift ;;
    --missions) [ "${2:-}" = full ] || die '--missions accepts full'; full=1; shift 2 ;;
    -h|--help) echo 'usage: tmux-agents status [--from ME] [--notes] [--handoff] [--missions full] [PEER]'; exit 0 ;;
    -*) die "unknown option: $1" ;;
    *) [ -z "$peer" ] || die 'expected one PEER'; peer="$1"; shift ;;
  esac
done
[ -n "$FROM_PANE" ] || trusted_pane || die 'untrusted pane: pass --from ME'
require_tmux
# Empty fields are deliberate: awk preserves them, unlike read with tab IFS.
snapshot="$(tmux list-panes -a -F '#{pane_id}	#{@agent}	#{@role}	#{@parent}	#{pane_current_command}	#{@state}	#{@state_since}	#{@perm_since}	#{@msg_waiting_since}	#{pane_dead}	#{@tracked}	#{@shell}	#{@peers}	#{@agent_id}	#{pane_current_path}	#{session_name}:#{window_index}.#{pane_index}	#{@activity}')"
# Saved kinds preserve configured profile names and avoid displaying node/cat.
records=()
dir="$(sessions_dir)"
for record in "$dir"/a*; do [ ! -f "$record" ] || records+=("$record"); done
kinds=''
if [ "${#records[@]}" -gt 0 ]; then
  kinds="$(awk -F= '$1=="kind" {n=split(FILENAME,a,"/"); print a[n] "\t" substr($0,6)}' "${records[@]}")"
fi
caller="${FROM_PANE:-${TMUX_PANE:-}}"
self="$(printf '%s\n' "$snapshot" | STATUS_CALLER="$caller" awk -F '\t' 'BEGIN {caller=ENVIRON["STATUS_CALLER"]} $1==caller || $2==caller {print $1; exit}')"
[ -n "$self" ] || die 'caller is not a live named agent; pass --from ME'
name="$(printf '%s\n' "$snapshot" | awk -F '\t' -v p="$self" '$1==p {print $2}')"
[ -n "$name" ] || die 'this pane has no name; run tmux-peers first'
target="$self"
if [ -n "$peer" ]; then
  target="$(printf '%s\n' "$snapshot" | STATUS_PEER="$peer" awk -F '\t' 'BEGIN {peer=ENVIRON["STATUS_PEER"]} $2==peer && $10!=1 && $12!=1 {print $1; exit}')"
  [ -n "$target" ] || die "no live agent named '$peer'"
  allowed="$(printf '%s\n' "$snapshot" | awk -F '\t' -v p="$self" -v t="$target" '$1==p {print (p==t || index(" " $13 " "," " t " ")>0)}')"
  [ "$allowed" = 1 ] || die "not connected to '$peer'"
fi
printf '%s\n' "$snapshot" | STATUS_PEER="$peer" STATUS_KINDS="$kinds" awk -F '\t' -v self="$self" -v target="$target" '
BEGIN {peer=ENVIRON["STATUS_PEER"]; kinds=ENVIRON["STATUS_KINDS"]}
function role(p, r,n,a) {
  r=f[p,3]; if(r=="") {n=split(f[p,2],a,"-");r=a[n]}
  if(r=="secondary") r="interface"
  return r ~ /^(main|designer|interface|worker|reviewer|runner|researcher)$/ ? r : "none"
}
function kind(p, n,a) {
  if(f[p,14] in saved_kind)return saved_kind[f[p,14]]
  n=split(f[p,2],a,"-")
  if(a[1]=="claude" || a[1]=="codex")return a[1]
  return f[p,5]
}
function status(p) {
  if(f[p,10]==1)return "exited"
  if(f[p,8]!="")return "permission"
  if(f[p,9]!="")return "message waiting"
  if(f[p,12]==1)return "shell"
  if(f[p,11]!=1)return "-"
  if(f[p,6]=="needs_you")return "needs you"
  return f[p,6]!="" ? f[p,6] : "working"
}
function since(p) {return f[p,8]!="" ? f[p,8] : (f[p,9]!="" ? f[p,9] : (f[p,7]!="" ? f[p,7] : "-"))}
function depth(p, n,seen) {n=0;seen="|"p"|";while(f[p,4] in exists) {p=f[p,4];if(index(seen,"|"p"|"))break;seen=seen p"|";n++}return n}
{p=$1;exists[p]=1;order[++total]=p;for(i=1;i<=NF;i++)f[p,i]=$i}
END {
  nk=split(kinds,rows,"\n");for(i=1;i<=nk;i++){split(rows[i],kv,"\t");saved_kind[kv[1]]=kv[2]}
  for(i=1;i<=total;i++) {
    child=order[i]; if(f[child,10]==1 || f[child,12]==1 || f[child,11]!=1 || f[child,6]!="working")continue
    p=f[child,4];seen="|"child"|"
    while((p in exists) && !index(seen,"|"p"|")) {
      if(f[p,10]==1 || f[p,12]==1 || f[p,6]=="working")break
      seen=seen p"|";waiting[p]=waiting[p] (waiting[p]!="" ? ", " : "") f[child,2];p=f[p,4]
    }
  }
  p=target
  printf "%s: %s (%s) role=%s parent=%s depth=%d kind=%s state=%s since=%s", (peer!=""?"peer":"you"), f[p,2],p,role(p),(f[p,4]!=""?f[p,4]:"-"),depth(p),kind(p),status(p),since(p)
  if(waiting[p]!="")printf " waiting on %s",waiting[p]
  printf "\n"
  if(peer!="") {if(f[p,17]!="")print "activity: " f[p,17];exit}
  n=split(f[self,13],peers," ");header=0
  for(i=1;i<=n;i++) {
    p=peers[i];if(!(p in exists)||f[p,10]==1||f[p,12]==1)continue
    if(!header++)print "peers:\nNAME\tPANE\tCOMMAND\tWHERE\tSTATE\tSINCE\tWAITING ON"
    printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\n",f[p,2],p,f[p,5],f[p,16],status(p),since(p),(waiting[p]!=""?waiting[p]:"-")
  }
}'
if [ -n "$peer" ]; then tmux capture-pane -p -t "$target" | tail -n 5; exit 0; fi
printf 'roles:\n'
"$here/tmux-agents-chain-config" --args --sources
root="$PWD"
if common="$(git rev-parse --git-common-dir 2>/dev/null)"; then
  case "$common" in /*) ;; *) common="$PWD/$common" ;; esac
  root="$(cd "$common/.." && pwd -P)"
fi
mission_args=()
[ "$full" = 0 ] || mission_args+=(--all)
missions="$("$here/tmux-agents-mission" list --from "$name" "${mission_args[@]+"${mission_args[@]}"}")"
if [ -n "$missions" ]; then
  printf 'missions:\n%s\n' "$missions"
  dir="$(mission_directory)"
  for record in "$dir"/M*.mission; do
    [ -f "$record" ] || continue
    if STATUS_OWNER="$name" awk -F= -v full="$full" 'BEGIN {owner=ENVIRON["STATUS_OWNER"]} $1=="owner" {mine=substr($0,7)==owner} $1=="status" {done=$2=="done"} END {exit !(mine && (full || !done))}' "$record"; then
      log="${record%.mission}.log"
      if [ -f "$log" ]; then printf '%s recent log:\n' "${log##*/}"; tail -n 3 "$log"; fi
    fi
  done
fi
id="$(printf '%s\n' "$snapshot" | awk -F '\t' -v p="$self" '$1==p {print $14}')"
if valid_agent_id "$id"; then
  if [ "$notes" = 1 ]; then
    . "$here/notes-lib.sh"
    _notes_store read "$id" 0 0 0 ''
  else
    # The shared notes reader prunes and locks even for count; this path never writes.
    dir="$(sessions_dir)"; dir="${dir%/sessions}/notes/$id"
    perl -MJSON::PP -e '
      use strict; use warnings;
      my ($dir)=@ARGV; my $cursor=0;
      if(open(my $fh,"<","$dir/.cursor")){my $s=<$fh>; $cursor=$s if defined($s) && $s=~/^\d+\s*$/}
      my %senders; my $count=0;
      for my $file (glob("$dir/*.json")) {
        open(my $fh,"<",$file) or next;my $n=eval {decode_json(do {local $/;<$fh>})};
        next unless ref($n) eq "HASH" && ($n->{id}//0)>$cursor && ($n->{at}//0)>time-604800;
        $count++;$senders{$n->{from_name}//"unknown"}++;
      }
      binmode STDOUT, ":encoding(UTF-8)";
      print "notes: $count unread; ",join(", ",map {"$_ ($senders{$_})"} sort keys %senders),"\n" if $count;
    ' "$dir"
  fi
fi
queue="$(message_queue_dir)"; pending=0
for file in "$queue"/*/*.msg "$queue"/*/*.sending "$queue"/*/*.undelivered "$queue"/*.msg "$queue"/*.sending "$queue"/*.undelivered; do
  [ ! -f "$file" ] || pending=$((pending+1))
done
[ "$pending" = 0 ] || printf 'messages: %s queued or undelivered (this server)\n' "$pending"
file="$root/HANDOFF.md"
if [ ! -f "$file" ]; then echo 'HANDOFF.md: none'
else
  if [ -n "$(git -C "$root" ls-files -- HANDOFF.md 2>/dev/null)" ]; then state='WARNING: tracked'
  elif git -C "$root" check-ignore -q HANDOFF.md 2>/dev/null; then state='present, untracked, ignored'
  else state='present, untracked, not ignored'; fi
  printf 'HANDOFF.md: %s (%s lines)\n' "$state" "$(wc -l < "$file" | tr -d ' ')"
  [ "$handoff" = 0 ] || cat "$file"
fi
