#!/usr/bin/env perl
# Internal durable request ledger. All mutations share a per-server lock.
use strict;
use warnings;
use Fcntl qw(:flock);
use File::Path qw(make_path);
use FindBin;

my ($op, @args) = @ARGV;
my $socket = (split /,/, $ENV{TMUX} // '')[0] // '';
die "request ledger requires a tmux socket\n" unless length $socket;
$socket =~ s{.*/}{};
my $root = ($ENV{XDG_STATE_HOME} // "$ENV{HOME}/.local/state") . "/tmux-agents/$socket/requests";
make_path($root);
open my $lock, '>>', "$root/.lock" or die "$!";
flock($lock, LOCK_EX) or die "$!";
my $now = time;
sub read_fields {
    my ($path) = @_; my %v;
    if (open my $f, '<', $path) {
        while (<$f>) { chomp; my ($k,$v)=split /=/, $_, 2; $v{$k}=$v if defined $v; }
    }
    return \%v;
}
sub save_fields {
    my ($path,$v)=@_;
    open my $f, '>', "$path.$$" or die "$!";
    print $f "$_=$v->{$_}\n" for sort keys %$v;
    close $f or die "$!";
    rename "$path.$$", $path or die "$!";
}
sub journal {
    my ($rid)=@_;
    open my $f, '>', "$root/$rid.journal" or die "$!";
    close $f or die "$!";
}
sub valid_id { defined $_[0] && $_[0] =~ /^a[0-9a-f]{12}$/ }
sub valid_request { defined $_[0] && $_[0] =~ /^r[0-9a-f]{12}$/ }
my %requests;
# Reports update one context; completed history is irrelevant to them. Small
# journal markers still make interrupted publication recoverable on any event.
my $context_only=$op =~ /^(progress|local|local-done|wait|notify|needs-you)$/;
my @journals=glob "$root/r*.journal";
$context_only=0 if @journals;
my @paths=$context_only ? () : glob("$root/r*.record");
for my $path (@paths) {
    my $v=read_fields($path);
    $requests{$v->{request_id}}=$v if valid_request($v->{request_id});
}
for my $path (@journals) {
    (my $rid=$path)=~s{.*/|\.journal$}{}g;
    unlink $path unless $requests{$rid} && $requests{$rid}{publication};
}
# Free text (waiting_on) is last: a stray tab inside it cannot shift fixed columns.
my @keys=qw(agent_id agent state tracked parent awaiting request_progress_at request_local_work request_local_done request_notify_digest request_pending_since attention_since shell pane_dead explicit_needs_you waiting_on);
my $fmt='#{pane_id}' . join('', map { $_ eq 'pane_dead' ? "\t#{pane_dead}" : "\t\#{\@$_}" } @keys);
open my $snap, '-|', 'tmux', 'list-panes', '-a', '-F', $fmt or die "$!";
my (%panes,%by_pane,@all_panes);
while (<$snap>) {
    chomp; my ($p,@v)=split /\t/, $_, scalar(@keys)+1;
    my %v; @v{@keys}=@v; $v{pane}=$p;
    push @all_panes,\%v;
    next unless valid_id($v{agent_id});
    $panes{$v{agent_id}}=\%v; $by_pane{$p}=$v{agent_id};
}
close $snap;
sub setopt {
    my ($id,$key,$value)=@_; return unless $panes{$id};
    return if ($panes{$id}{$key} // '') eq ($value // '');
    my @cmd=('tmux','set-option',length($value // '') ? '-p' : '-pu','-t',$panes{$id}{pane},'@'.$key);
    push @cmd,$value if length($value // '');
    system(@cmd)==0 or die "cannot project request $key\n";
    $panes{$id}{$key}=$value // '';
}
sub state {
    my ($id,$value)=@_; return unless $panes{$id} && $panes{$id}{tracked} eq '1';
    system('/bin/bash','-c','. "$1"; agent_set_state "$2" "$3"','request-state',"$FindBin::Bin/lib.sh",$panes{$id}{pane},$value)==0 or die "cannot set request state\n";
    $panes{$id}{state}=$value;
}
sub pending {
    my ($id)=@_; return grep { $_->{receiver_id} eq $id && $_->{status} eq 'pending' } values %requests;
}
# A receiver that is gone cannot be waited on; its pending request keeps its
# identity (delivery resumes if it is reopened) but blocks nobody meanwhile.
sub live { my ($id)=@_; $panes{$id} && $panes{$id}{pane_dead} ne '1' }
sub outgoing {
    my ($id)=@_;
    return grep { $_->{requester_id} eq $id && $_->{status} eq 'pending' && live($_->{receiver_id}) } values %requests;
}
sub kids {
    my ($pane)=@_;
    return grep { $_->{parent} eq $pane && $_->{state} ne 'done' && $_->{shell} ne '1' && $_->{pane_dead} ne '1' } @all_panes;
}
sub legacy_awaits {
    my ($id)=@_; my %known=map { $_->{receiver_id}=>1 } grep { $_->{requester_id} eq $id } values %requests;
    return grep { !$known{$_} && live($_) } split /\s+/, $panes{$id}{awaiting} // '';
}
my %background;
sub background {
    my ($pane)=@_;
    return $background{$pane} if exists $background{$pane};
    open my $bg, '-|', '/bin/bash','-c','. "$1"; claude_background "$2"','request-state',"$FindBin::Bin/lib.sh",$pane or die "$!";
    my $running=<$bg> // 0; close $bg; chomp $running;
    return $background{$pane}=($running > 0 ? 1 : 0);
}
# Everything that keeps an agent from finishing, apart from local work. A
# parent-notice pause is coordination, not work: it never blocks completion.
sub busy {
    my ($id)=@_; my $v=$panes{$id};
    return 1 if pending($id) || outgoing($id) || kids($v->{pane}) || legacy_awaits($id);
    return 1 if length($v->{waiting_on} // '') && $v->{waiting_on} !~ / \(after a notice\)$/;
    return 0;
}
sub context { read_fields("$root/$_[0].context") }
# Accept one Codex turn-end notification; false for a repeated identity.
sub notify {
    my ($id,$digest,$kind)=@_;
    my $c=context($id);
    return 0 if ($c->{notify_digest} // '') eq $digest;
    $c->{notify_digest}=$digest; $c->{progress_at}=$now;
    if ($kind eq 'local' && !$panes{$id}{request_local_done} && !$panes{$id}{explicit_needs_you}) {
        $c->{base} ||= $panes{$id}{parent} ? 'done' : 'idle';
        # Inferred local work: the turn that ends now completes it unless
        # the agent reported it explicitly (--local) or other work remains.
        $c->{local_work}=1;
        # A completion callback cannot reconstruct an unreported work start.
        # From idle/done it flags unfinished local work without opening a
        # synthetic working interval during notification processing.
        state($id,$panes{$id}{state} =~ /^(idle|done)$/ ? 'needs_you' : 'working');
        setopt($id,'request_local_work','1');
    }
    setopt($id,'request_notify_digest',$digest);
    setopt($id,'request_progress_at',"$now");
    setopt($id,'request_local_done','');
    delete $c->{local_done}; save_context($id,$c);
    return 1;
}
# Restore the pre-request state once nothing is outstanding. False while
# work remains or no request ever recorded a base to return to.
sub finish {
    my ($id,$legacy)=@_; my $v=$panes{$id}; my $c=context($id);
    return 0 if $v->{explicit_needs_you};
    return 0 if busy($id) || $c->{local_work} || $v->{request_local_work};
    return 0 unless $c->{base} || $legacy;
    return 0 if background($v->{pane});
    state($id,$c->{base} || 'done');
    setopt($id,'attention_since','');
    setopt($id,'waiting_on','');
    if ($c->{notify_digest} || $c->{local_done}) { my %receipt=map { $_=>$c->{$_} } grep { exists $c->{$_} } qw(notify_digest local_done); save_context($id,\%receipt); }
    else { unlink "$root/$id.context"; }
    return 1;
}
sub save_context { save_fields("$root/$_[0].context",$_[1]) }
sub activate {
    my ($r,$spawn,$prepare_only)=@_; my $id=$r->{receiver_id}; return unless $panes{$id};
    my $c=context($id);
    if (!length($c->{base} // '')) {
        my $v=$panes{$id};
        $c->{base}= $spawn ? 'done' : ($v->{state} eq 'idle' || !length($v->{parent} // '') ? 'idle' : 'done');
        $c->{local_work}= !$spawn && ($v->{request_local_work} || ($v->{state} !~ /^(done|idle)$/ && !length($v->{waiting_on} // '') && !length($v->{awaiting} // '') && ($panes{$r->{requester_id}}{pane} // '') ne $v->{parent})) ? 1 : 0;
        $c->{saved_wait}=$v->{waiting_on} // '';
        save_context($id,$c);
    }
    return if $prepare_only;
    setopt($id,'explicit_needs_you','');
    state($id,'working');
    setopt($id,'attention_since','');
    # A parent coordination marker is superseded by a new request. Actual
    # background waits remain outstanding work across peer interruptions.
    if (($panes{$id}{waiting_on} // '') =~ / \(after a notice\)$/) {
        setopt($id,'waiting_on',''); $c->{saved_wait}=''; save_context($id,$c);
    }
}
# Complete write-ahead publication after recovering the original context.
for my $r (values %requests) {
    my $path=$r->{publication} // ''; next unless length $path;
    activate($r,'') if $r->{status} eq 'pending';
    if (-f "$path.tmp") { rename "$path.tmp",$path or die "cannot recover publication: $!"; }
    delete $r->{publication}; save_fields("$root/$r->{request_id}.record",$r);
    unlink "$root/$r->{request_id}.journal";
}
my $result='';
if ($op eq 'create' || $op eq 'publish-create') {
    my ($rid,$from,$to,$extra)=@args;
    my $spawn=$op eq 'create' ? $extra : '';
    my $publication=$op eq 'publish-create' ? $extra : '';
    die "missing staged request body\n" if $publication && !-f "$publication.tmp";
    die "invalid request identity\n" unless valid_request($rid) && valid_id($from) && valid_id($to);
    die "request already exists\n" if $requests{$rid};
    my $r={request_id=>$rid,requester_id=>$from,receiver_id=>$to,created_at=>$now,delivered_at=>'',replied_at=>'',status=>'pending'};
    if ($publication) { $r->{publication}=$publication; journal($rid); }
    $requests{$rid}=$r;
    # Persist the pre-request baseline before the publication journal can commit.
    activate($r,$spawn,1);
    save_fields("$root/$rid.record",$r);
    # Capture the pre-request work state before any delivery or hook.
    if ($spawn && !$panes{$to}) { save_context($to,{base=>'done',local_work=>0,saved_wait=>''}); }
    activate($r,$spawn);
    if ($publication) {
        rename "$publication.tmp",$publication or die "cannot publish request: $!";
        delete $r->{publication}; save_fields("$root/$rid.record",$r);
        unlink "$root/$rid.journal";
    }
} elsif ($op eq 'cancel') {
    my $r=$requests{$args[0]} or exit 0;
    if ($r->{status} eq 'pending' && !$r->{delivered_at}) {
        $r->{status}='cancelled'; $r->{cancelled_at}=$now;
        save_fields("$root/$args[0].record",$r);
        unlink "$root/$r->{receiver_id}.context" if !pending($r->{receiver_id}) && !$panes{$r->{receiver_id}};
    }
} elsif ($op eq 'delivered') {
    my $r=$requests{$args[0]} or die "unknown request\n";
    if ($r->{status} eq 'pending' && !$r->{delivered_at}) {
        $r->{delivered_at}=$now; save_fields("$root/$args[0].record",$r);
    }
} elsif ($op eq 'resolve') {
    my ($from,$to,$rid)=@args;
    my @matches=sort map { $_->{request_id} } grep { $_->{receiver_id} eq $from && $_->{requester_id} eq $to && $_->{status} eq 'pending' } values %requests;
    if (length($rid // '')) {
        die "request does not match this pending reply\n" unless valid_request($rid) && grep { $_ eq $rid } @matches;
        $result=$rid;
    } else {
        die "ambiguous reply; pass --request-id: @matches\n" if @matches>1;
        $result=$matches[0] // '';
    }
} elsif ($op eq 'publish-answer') {
    my ($rid,$from,$to,$publication)=@args;
    my $r=$requests{$rid};
    unless ($r && $r->{status} eq 'pending' && $r->{receiver_id} eq $from && $r->{requester_id} eq $to) {
        # This invocation lost the commit race; its private staged pair is
        # not referenced by the winning publication and must not accumulate.
        unlink "$publication.tmp";
        (my $meta=$publication)=~s/\.msg$/.meta/;
        unlink $meta if $meta ne $publication;
        die "request does not match this pending reply\n";
    }
    die "missing staged reply body\n" unless -f "$publication.tmp";
    # Write ahead: another publisher cannot claim this request. Recovery
    # finishes the rename if this process dies between journal and publish.
    $r->{publication}=$publication; journal($rid);
    $r->{status}='answered'; $r->{replied_at}=$now;
    save_fields("$root/$rid.record",$r);
    rename "$publication.tmp",$publication or die "cannot publish reply: $!";
    delete $r->{publication}; save_fields("$root/$rid.record",$r);
        unlink "$root/$rid.journal";
} elsif ($op eq 'answered') {
    my $r=$requests{$args[0]} or die "unknown request\n";
    $r->{status}='answered'; $r->{replied_at}=$now;
    save_fields("$root/$args[0].record",$r);
} elsif ($op eq 'needs-you') {
    my $id=$by_pane{$args[0]} // '';
    die "--needs-you requires a tracked agent\n" unless $id && $panes{$id}{tracked} eq '1' && $panes{$id}{shell} ne '1';
    die "--needs-you requires a reason\n" unless length($args[1] // '');
    # Attention is not a reply or completion. Keep every obligation intact.
    setopt($id,'explicit_needs_you','1');
    state($id,'needs_you');
    setopt($id,'attention_since',"$now") unless $panes{$id}{attention_since};
    setopt($id,'activity',$args[1]);
} elsif ($op eq 'local-done') {
    my $id=$by_pane{$args[0]} // ''; exit 0 unless $id;
    setopt($id,'request_local_work','');
    setopt($id,'request_local_done','1');
    my $c=context($id);
    $c->{base} ||= $panes{$id}{parent} ? 'done' : 'idle';
    $c->{local_work}=0; delete $c->{local_explicit}; $c->{local_done}=1; save_context($id,$c);
} elsif ($op eq 'notify') {
    my $id=$by_pane{$args[0]} // ''; exit 1 unless $id;
    notify($id,@args[1,2]) or exit 1;
} elsif ($op eq 'progress' || $op eq 'local') {
    my $id=$by_pane{$args[0]} // ''; exit 0 unless $id;
    setopt($id,'explicit_needs_you','');
    setopt($id,'request_progress_at',"$now");
    my $c=context($id);
    $c->{progress_at}=$now;
    save_context($id,$c);
    if ($op eq 'local') {
        state($id,'working');
        setopt($id,'request_local_work','1');
        setopt($id,'request_local_done','');
        setopt($id,'request_notify_digest','');
        delete $c->{notify_digest}; delete $c->{local_done};
        $c->{base} ||= $panes{$id}{parent} ? 'done' : 'idle';
        $c->{local_work}=1;
        # --local is a promise to call --local-done; a prompt start is not.
        if (($args[1] // '') eq 'explicit') { $c->{local_explicit}=1 } else { delete $c->{local_explicit} }
        save_context($id,$c);
    }
} elsif ($op eq 'incoming') {
    my $id=$by_pane{$args[0]} // ''; exit 0 unless $id;
    $result=join(' ',sort map { $_->{request_id} } pending($id));
} elsif ($op eq 'turn-end') {
    # One locked decision per turn end: optional Codex notify acceptance,
    # completion, then the needs-you rule over the same ledger snapshot.
    my ($pane,$digest,$kind)=@args;
    my $id=$by_pane{$pane} // ''; exit 0 unless $id;
    if (length($digest // '')) { notify($id,$digest,$kind) or exit 0; }
    else { my $c=context($id); $c->{progress_at}=$now; save_context($id,$c); setopt($id,'request_progress_at',"$now"); }
    my $v=$panes{$id}; my $c=context($id);
    # Explicit user attention outlives notifications and turn completion.
    exit 0 if $v->{explicit_needs_you};
    # Local work inferred from a prompt ends with its turn when nothing else
    # is outstanding. Only --local keeps it open until --local-done. The
    # prompt was the work: there is no earlier state to restore, so the
    # ordinary idle/needs-you rule below decides.
    my $completed_local=0;
    if ($c->{local_work} && !$c->{local_explicit} && !busy($id) && !background($pane)) {
        $c->{local_work}=0; delete $c->{base}; delete $c->{local_explicit}; save_context($id,$c);
        setopt($id,'request_local_work',''); $completed_local=1;
    }
    exit 0 if !$completed_local && finish($id);
    my @incoming=pending($id); my $local=$c->{local_work} || $v->{request_local_work};
    if (!@incoming && !$local && $v->{state} =~ /^(done|idle)$/) {
        system('/bin/bash','-c','. "$1"; agent_turn_state "$2" end ""','request-state',"$FindBin::Bin/lib.sh",$pane)==0 or die "cannot finish turn\n";
        exit 0;
    }
    my %seen; my @who;
    for my $k (sort { $a->{pane} cmp $b->{pane} } kids($pane)) { push @who,$k->{agent} if length($k->{agent} // '') && !$seen{$k->{agent}}++; }
    for my $r (sort { $a->{created_at} <=> $b->{created_at} } outgoing($id)) { my $n=$panes{$r->{receiver_id}}{agent} // ''; push @who,$n if length($n) && !$seen{$n}++; }
    for my $n (legacy_awaits($id)) { my $name=$panes{$n}{agent} // ''; push @who,$name if length($name) && !$seen{$name}++; }
    # Names are single words; the waiting reason is a phrase, added last.
    my $reason=$v->{waiting_on} // '';
    $reason='background command' if !length($reason) && background($pane);
    my $who=join(', ',@who); $who.=(length($who) ? ', ' : '').$reason if length $reason;
    my ($desired,$activity)=('','');
    if (length $who) { ($desired,$activity)=('working',"waiting for $who"); }
    elsif (!@incoming && !$local && !length($v->{parent} // '')) { $desired='idle'; }
    else { $desired='needs_you'; }
    system('/bin/bash','-c','. "$1"; agent_turn_state "$2" end "$3"','request-state',"$FindBin::Bin/lib.sh",$pane,$desired)==0 or die "cannot finish turn\n";
    open my $state_read, '-|', 'tmux','show-options','-pqv','-t',$pane,'@state' or die "$!";
    my $actual=<$state_read> // ''; close $state_read; chomp $actual;
    if ($actual eq 'needs_you') { setopt($id,'attention_since',"$now") unless $v->{attention_since}; }
    else { setopt($id,'attention_since',''); }
    setopt($id,'activity',$activity) if length($activity) && $actual eq 'working';
} elsif ($op eq 'finish' || $op eq 'legacy-finish') {
    my $id=$by_pane{$args[0]} // ''; exit 1 unless $id;
    # Validation, terminal projection and context removal share the create lock.
    finish($id,$op eq 'legacy-finish') or exit 1;
} elsif ($op eq 'wait') {
    my $id=$by_pane{$args[0]} // ''; exit 0 unless $id;
    my $c=context($id);
    $c->{saved_wait}=$args[1] // '';
    $c->{base} ||= $panes{$id}{parent} ? 'done' : 'idle' if length $c->{saved_wait};
    save_context($id,$c); setopt($id,'waiting_on',$c->{saved_wait});
} elsif ($op eq 'restore') {
    my $id=$by_pane{$args[0]} // ''; exit 0 unless $id;
    my $c=context($id);
    setopt($id,'request_local_work',$c->{local_work} ? '1' : '');
    setopt($id,'waiting_on',$c->{saved_wait} // '');
    setopt($id,'request_progress_at',$c->{progress_at} // '');
    setopt($id,'request_notify_digest',$c->{notify_digest} // '');
    setopt($id,'request_local_done',$c->{local_done} // '');
    state($id,'working') if pending($id) || $c->{local_work} || $c->{saved_wait};
} elsif ($op ne 'sync') { die "unknown request ledger operation\n"; }
# Derive compatibility waits and overdue UI fields from the durable ledger.
# Pending requests survive close/reopen; labels never participate in identity.
unless ($context_only || $op eq 'resolve' || $op eq 'incoming') {
    my (%in,%known,%out);
    for my $r (values %requests) {
        $known{$r->{requester_id}}{$r->{receiver_id}}=1;
        next unless $r->{status} eq 'pending';
        push @{$in{$r->{receiver_id}}},$r;
        $out{$r->{requester_id}}{$r->{receiver_id}}=1 if live($r->{receiver_id});
    }
    for my $id (keys %panes) {
        my @in=@{$in{$id} // []};
        my @delivered=sort {$a<=>$b} map { $_->{delivered_at} } grep { $_->{delivered_at} } @in;
        setopt($id,'request_pending_since',@delivered ? $delivered[0] : '');
        my %known=%{$known{$id} // {}};
        my %out=%{$out{$id} // {}};
        # Keep waits created by older tools that have no ledger entry, dropping only IDs of panes that are gone.
        for my $old (split /\s+/, $panes{$id}{awaiting} // '') { $out{$old}=1 if !$known{$old} && (!valid_id($old) || live($old)); }
        setopt($id,'awaiting',join(' ',sort keys %out));
    }
}
# Keep terminal identities for seven days, longer while a queued message
# refers to them. Never age out pending obligations. Context-only progress
# does not scan history; maintenance runs on sync and at most daily otherwise.
unless ($context_only || $op eq 'resolve' || $op eq 'incoming') {
    my $maintenance=read_fields("$root/.maintenance");
    if ($op eq 'sync' || $now-($maintenance->{pruned_at} // 0)>86400) {
        my %queued;
        my $queue="/tmp/tmux-agents-$</queue/$socket";
        for my $path (glob "$queue/*.meta") {
            my $m=read_fields($path);
            $queued{$m->{request_id}}=1 if valid_request($m->{request_id});
        }
        for my $r (values %requests) {
            next if $r->{status} eq 'pending' || $r->{publication} || $queued{$r->{request_id}};
            my $ended=$r->{replied_at} || $r->{cancelled_at} || 0;
            unlink "$root/$r->{request_id}.record" if $ended && $now-$ended>604800;
        }
        save_fields("$root/.maintenance",{pruned_at=>$now});
    }
}
print "$result\n" if length $result;
