#!/usr/bin/env bash
# Browse agent panes: live preview, open hidden ones in a popup, jump, dismiss.
set -euo pipefail
here="$(cd "${BASH_SOURCE[0]%/*}" && pwd)"
. "$here/lib.sh"

usage() {
  cat <<'EOF'
usage: tmux-agents [--client NAME]

Lists sub agents (spawned with tmux-spawn) with a live preview.
Bound to prefix + a.

  enter   open it: hidden agents in a popup (prefix + d closes), others jump
  ctrl-o  jump to it full screen (prefix + L jumps back)
  ctrl-x  dismiss (close its subtree)
  ctrl-d  clean up wholly done or exited subtrees (asks first)
  ctrl-a  toggle between sub agents and every named pane
  ctrl-t  toggle between this window and all windows
  ctrl-r  refresh

Settings (environment overrides option):
  retention: option @tmux_agents_resume_days, env TMUX_AGENTS_RESUME_DAYS (7 days)
  preview: option @tmux_agents_preview_secs, env TMUX_AGENTS_PREVIEW_SECS (0.5 seconds)
  blink: option @tmux_agents_blink_secs, env TMUX_AGENTS_BLINK_SECS (60 seconds)
  animation: option @tmux_agents_chip_fps (10 frames per second)
  sessions: option @tmux_agents_session_prefix, env TMUX_AGENTS_PREFIX (agents)
EOF
}

# Both view dimensions travel in FZF_PROMPT during reloads, not global scope.
list_prompt() {
  local label=agents scope='this window'
  [ "$1" != all ] || label=all
  [ "$2" != all ] || scope='all windows'
  printf '%s · %s> ' "$label" "$scope"
}
parse_prompt() {
  list_mode=sub list_scope=window
  case "$1" in all*) list_mode=all ;; esac
  case "$1" in *'all windows>'*) list_scope=all ;; esac
}

# Use byte-wise replacement, matching agents_session_for's tr under any locale.
list_project_label() { local LC_ALL=C; project="${1//[^a-zA-Z0-9_-]/-}"; }

# A rebuild makes one pane snapshot and one batched record read. Graph walks,
# sorting and alignment happen in awk; external work never scales with agents.
list_agents() {
  local mode="${1:-sub}" scope="${2:-window}" client="${3:-}" snapshot window="" clients c w
  local now records="" raw="" mtimes="" dir sock f tag rest path root project paths="" projects=""
  local -a files=() expired=()
  local tab=$'\t' nl=$'\n' resume_days
  ensure_agent_ids
  settings_get AGENTS_PREFIX TMUX_AGENTS_PREFIX @tmux_agents_session_prefix agents
  settings_get resume_days TMUX_AGENTS_RESUME_DAYS @tmux_agents_resume_days 7
  snapshot="$(tmux list-panes -a -F 'P	#{pane_id}	#{?@agent,#{@agent},-}	#{pane_dead}	#{?@perm_since,#{@perm_since},-}	#{?@state,#{@state},-}	#{?@parent,#{@parent},-}	#{session_name}	#{?@activity,#{@activity},-}	#{pane_current_path}	#{session_name}:#{window_index}	#{?@attention_since,#{@attention_since},-}	#{?@msg_waiting_since,#{@msg_waiting_since},-}	#{window_id}	#{?@agent_id,#{@agent_id},-}')"
  if [ -n "$client" ]; then
    clients="$(tmux list-clients -F '#{client_name}	#{window_id}')"
    while IFS="$tab" read -r c w; do [ "$c" != "$client" ] || { window="$w"; break; }; done <<<"$clients"
    # A disappeared client must not silently fall back to the reload pane.
    [ -n "$window" ] || window=missing-client
  elif [ -z "${TMUX_PANE:-}" ]; then
    window="$(tmux display-message -p '#{window_id}')"
  fi
  now="$(date +%s)"
  sock="${TMUX%%,*}"; dir="${XDG_STATE_HOME:-$HOME/.local/state}/tmux-agents/${sock##*/}/sessions"
  for f in "$dir"/*; do [ ! -f "$f" ] || files+=("$f"); done
  if [ ${#files[@]} -gt 0 ]; then
    case "$OSTYPE" in
      darwin*|*bsd*) mtimes="$(stat -f "%m$tab%N" "${files[@]}")" ;;
      *) mtimes="$(stat -c "%Y$tab%n" "${files[@]}")" ;;
    esac
    raw="$(LIST_MTIMES="$mtimes" awk -v now="$now" -v keep="$(( $resume_days * 86400 ))" -f "$here/tmux-agents-records.awk" "${files[@]}")"
    while IFS="$tab" read -r tag rest; do
      if [ "$tag" = X ]; then expired+=("$rest")
      elif [ "$tag" = R ]; then records="$records$tag$tab$rest$nl"
      fi
    done <<<"$raw"
    [ ${#expired[@]} -eq 0 ] || rm -f "${expired[@]}"
  fi
  # Deduplicate directories across live panes and records before git lookup.
  paths="$(printf '%s\n%s' "$snapshot" "$records" | awk -F '\t' -v prefix="$AGENTS_PREFIX-" '
    $1 == "P" && index($8,prefix) != 1 { path=$10; if (!seen[path]++) print path }
    $1 == "R" { path=$6; if (!seen[path]++) print path }')"
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    root="$(git -C "$path" rev-parse --show-toplevel 2>/dev/null)" || root="$path"
    if [ "$root" = "$HOME" ]; then project=home
    else
      root="${root%/}"; project="${root##*/}"
      [ -n "$project" ] || project=-
      # Match agents_session_for's ASCII sanitization without another process.
      list_project_label "$project"
    fi
    projects="$projects""D$tab$path$tab$project$nl"
  done <<<"$paths"
  printf '%s\n%s%s' "$snapshot" "$records" "$projects" |
    LIST_PREFIX="$AGENTS_PREFIX" LIST_NOW="$now" LIST_WINDOW="$window" LIST_SCOPE="$scope" LIST_MODE="$mode" awk -f "$here/tmux-agents-list.awk"
}

# Check only when enabling the layout, never on the list/chip refresh paths.
warn_broken_skill_links() {
  local homes entry dir link seen candidate duplicate
  local dirs=("$HOME/.claude/skills" "$HOME/.codex/skills" "${CODEX_HOME:-$HOME/.codex}/skills")
  resolve_codex_homes homes
  for entry in $homes; do
    case "$entry" in *=?*) dirs+=("${entry#*=}/skills") ;; esac
  done
  seen=()
  for dir in "${dirs[@]}"; do
    duplicate=0
    for candidate in "${seen[@]+"${seen[@]}"}"; do
      [ "$candidate" != "$dir" ] || duplicate=1
    done
    [ "$duplicate" = 0 ] || continue
    seen+=("$dir")
    for link in "$dir"/tmux-agents* "$dir"/agent-chain; do
      if [ -L "$link" ] && [ ! -e "$link" ]; then
        printf 'tmux-agents: warning: broken skill symlink: %s; rerun install.sh from the installation checkout to repair it.\n' "$link" >&2
      fi
    done
  done
}

# Two-line status bar while sub agents exist: the chip line on top, the
# user's own status line below. "on" saves their line in
# @tmux_agents_main_format; "off" puts it back.
chip_layout() {
  local cur main fps
  if [ "$1" = on ]; then
    warn_broken_skill_links
    cur="$(tmux show-options -gv 'status-format[0]')"
    case "$cur" in *"tmux-agents --chip"*|*"@chip"*) ;; *) tmux set-option -g @tmux_agents_main_format "$cur" ;; esac
    main="$(tmux show-options -gqv @tmux_agents_main_format)"
    settings_get fps "" @tmux_agents_chip_fps 10
    tmux set-option -g 'status-format[1]' "$main"
    if [ "${fps:-10}" -gt 1 ] 2>/dev/null; then
      # Pushed by the chip daemon at $fps frames a second.
      # The #() part prints nothing; it restarts the daemon if it died.
      tmux set-option -g 'status-format[0]' "#{@chip}#($here/tmux-agents --chip-ensure)"
      tmux run-shell -b "'$here/tmux-agents' --chip-daemon"
    else
      # Re-run by tmux every status-interval (1s at most).
      tmux set-option -g 'status-format[0]' "#($here/tmux-agents --chip)"
    fi
    tmux set-option -g status 2
  else
    main="$(tmux show-options -gqv @tmux_agents_main_format)"
    [ -n "$main" ] || return 0
    tmux set-option -g 'status-format[0]' "$main"
    tmux set-option -gu 'status-format[1]'
    tmux set-option -g status on
  fi
}

# One per tmux server, started by chip_layout: rebuild the chip once a
# second, animate its spinner at @tmux_agents_chip_fps (default 10), and
# push it into @chip with a redraw. Exits once the chip line is gone.
chip_daemon() {
  local pid fps delay frames tick=0 last=-1 now template line c log
  pid="$(tmux show-options -gqv @tmux_agents_chip_pid)"
  if [ -n "$pid" ] && [ "$pid" != $$ ] && kill -0 "$pid" 2>/dev/null; then return 0; fi
  tmux set-option -g @tmux_agents_chip_pid $$
  # Two clients' --chip-ensure can start daemons in the same second; the
  # last one to register wins and the others leave.
  sleep 0.3
  [ "$(tmux show-options -gqv @tmux_agents_chip_pid)" = $$ ] || return 0
  # A long-running loop: one failing tmux call (say a client detaching
  # between list-clients and refresh-client) must not end it.
  set +e +o pipefail
  log="/tmp/tmux-agents-$(id -u)/chip-daemon.log"
  mkdir -p "$(dirname "$log")"
  exec 2>>"$log"
  settings_get fps "" @tmux_agents_chip_fps 10
  case "$fps" in ''|*[!0-9]*) fps=10 ;; esac
  [ "$fps" -le 30 ] || fps=30
  delay="$(awk -v f="$fps" 'BEGIN { printf "%.3f", 1 / f }')"
  frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
  while :; do
    now="$(date +%s)"
    if [ "$now" != "$last" ]; then
      case "$(tmux show-options -gv 'status-format[0]' 2>/dev/null)" in *"@chip"*) ;; *) echo "$(date '+%F %T') chip line gone, exiting" >&2; break ;; esac
      template="$(CHIP_SPIN=@@SPIN@@ chip)"
      last="$now"
    fi
    line="${template//@@SPIN@@/${frames[$((tick % 10))]}}"
    tmux set-option -g @chip "$line" 2>/dev/null || { echo "$(date '+%F %T') tmux server gone, exiting" >&2; break; }
    for c in $(tmux list-clients -F '#{client_name}' 2>/dev/null); do tmux refresh-client -S -t "$c" 2>/dev/null; done
    tick=$((tick + 1))
    sleep "$delay"
  done
  tmux set-option -gu @tmux_agents_chip_pid 2>/dev/null || true
  tmux set-option -gu @chip 2>/dev/null || true
}

# "stone-age" from agents-projects-stone-age, at most 10 characters.
short_project() {
  local p="${1#"$AGENTS_PREFIX"-}"
  p="${p#projects-}"; p="${p#project-}"
  [ "${#p}" -le 10 ] || p="${p:0:9}…"
  printf '%s' "$p"
}

# Long task names keep their start and end: seimu-jyaruga-map-audit -> seimu-j…map-audit
short_task() {
  [ "${#1}" -le 18 ] && { printf '%s' "$1"; return; }
  printf '%s…%s' "${1:0:7}" "${1:$((${#1} - 10))}"
}

# The chip, centred: one focus agent that rotates every 4s, then
# per-project counts. Agents waiting for permission take over the focus and turn red; past
# TMUX_AGENTS_BLINK_SECS (default 60) unanswered, they blink.
chip() {
  local now frames spin rows id name dead st session since activity state act attention waiting blink_secs
  settings_get AGENTS_PREFIX TMUX_AGENTS_PREFIX @tmux_agents_session_prefix agents
  settings_get blink_secs TMUX_AGENTS_BLINK_SECS @tmux_agents_blink_secs 60
  local -a ids names states acts projs sinces
  now="$(date +%s)"
  frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
  # CHIP_SPIN lets the chip daemon put a placeholder here and animate it.
  spin="${CHIP_SPIN:-${frames[$((now % 10))]}}"
  rows="$(tmux list-panes -a -F '#{pane_id}	#{?@agent,#{@agent},-}	#{pane_dead}	#{?@state,#{@state},-}	#{session_name}	#{?@perm_since,#{@perm_since},-}	#{?@activity,#{@activity},-}	#{?@parent,1,0}	#{?@attention_since,#{@attention_since},-}	#{?@msg_waiting_since,#{@msg_waiting_since},-}' \
    | awk -F '\t' '(($8 == 1 && $2 != "-") || $10 != "-") && !seen[$1]++')"
  if [ -z "$rows" ]; then
    [ "$(tmux show-options -gv status)" != 2 ] || tmux run-shell -b "'$here/tmux-agents' --chip-layout off"
    return 0
  fi
  # State comes from what agents report: tmux-agent-report sets @activity,
  # Claude's permission hook sets @perm_since, a reply to the parent sets
  # done, and a turn that ends without either sets needs_you.
  while IFS="$(printf '\t')" read -r id name dead st session since activity _ attention waiting; do
    [ "$name" != - ] || name="$id"
    if [ "$dead" = 1 ]; then
      state=exited act="exited"
    elif [ "$since" != - ]; then
      state=perm act="NEEDS PERMISSION"
    elif [ "$waiting" != - ]; then
      state=message act="message waiting" since="$waiting"
      [[ $since =~ ^[0-9]+$ ]] || since="$now"
    elif [ "$st" = idle ]; then
      state=idle act="idle"
    elif [ "$st" = done ]; then
      state=done act="done"
    elif [ "$st" = needs_you ]; then
      state=needs act="NEEDS YOU" since="$attention"
      [ "$since" != - ] || since="$now"
    else
      state=work act="$activity"
      [ "$act" != - ] || act="starting"
    fi
    ids+=("$id"); names+=("$name"); states+=("$state"); acts+=("$act"); projs+=("$(short_project "$session")"); sinces+=("$since")
  done <<EOF
$rows
EOF

  # Per-project counts, in first-seen order.
  local out="" seen_projs=" " pj i n w d idle pm nd mw ex seg
  for pj in "${projs[@]}"; do
    case "$seen_projs" in *" $pj "*) continue ;; esac
    seen_projs="$seen_projs$pj "
    w=0 d=0 idle=0 pm=0 nd=0 mw=0 ex=0
    for ((i = 0; i < ${#ids[@]}; i++)); do
      [ "${projs[i]}" = "$pj" ] || continue
      case "${states[i]}" in work) w=$((w+1)) ;; idle) idle=$((idle+1)) ;; done) d=$((d+1)) ;; perm) pm=$((pm+1)) ;; needs) nd=$((nd+1)) ;; message) mw=$((mw+1)) ;; exited) ex=$((ex+1)) ;; esac
    done
    seg="#[fg=colour250]$pj#[default]"
    [ "$pm" -eq 0 ] || seg="$seg #[fg=white,bg=red,bold] ⚠ $pm #[default]"
    [ "$nd" -eq 0 ] || seg="$seg #[fg=black,bg=colour214,bold] ◆ $nd #[default]"
    [ "$mw" -eq 0 ] || seg="$seg #[fg=black,bg=colour214,bold] ✉ $mw #[default]"
    [ "$w" -eq 0 ] || seg="$seg #[fg=colour117]$spin $w#[default]"
    [ "$idle" -eq 0 ] || seg="$seg #[fg=colour244]○ $idle#[default]"
    [ "$d" -eq 0 ] || seg="$seg #[fg=colour114]✓ $d#[default]"
    [ "$ex" -eq 0 ] || seg="$seg #[fg=colour240]✗ $ex#[default]"
    out="${out:+$out #[fg=colour240]·#[default] }$seg"
  done

  # Focus: rotate through agents that need the user (permission or
  # otherwise) if any, else all.
  local -a cand=()
  for ((i = 0; i < ${#ids[@]}; i++)); do case "${states[i]}" in perm|needs|message) cand+=("$i") ;; esac; done
  [ ${#cand[@]} -gt 0 ] || for ((i = 0; i < ${#ids[@]}; i++)); do cand+=("$i"); done
  i="${cand[$(( (now / 4) % ${#cand[@]} ))]}"
  local icon style focus
  case "${states[i]}" in
    perm) icon="⚠" ;;
    needs) icon="◆" ;;
    message) icon="✉" ;;
    work) icon="$spin" ;;
    idle) icon="○" ;;
    done) icon="✓" ;;
    exited) icon="✗" ;;
    *) icon="◦" ;;
  esac
  focus="$icon $(short_task "${names[i]}"): ${acts[i]}"
  if [ "${states[i]}" = perm ] || [ "${states[i]}" = needs ] || [ "${states[i]}" = message ]; then
    if [ "${states[i]}" = perm ]; then style="fg=white,bg=red,bold"; else style="fg=black,bg=colour214,bold"; fi
    [ $((now - ${sinces[i]})) -lt "$blink_secs" ] || style="$style,blink"
    focus="#[$style] $focus #[default]"
  elif [ "${states[i]}" = idle ]; then
    focus="#[fg=colour244]$focus#[default]"
  else
    focus="#[fg=colour252]$focus#[default]"
  fi
  # Focus, then per-project status, centred on the line.
  printf '#[align=centre]%s  #[fg=colour240]│#[default]  %s' "$focus" "$out"
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  # fzf reloads call this; the prompt says which view is showing.
  --chip) require_tmux; chip; exit 0 ;;
  --chip-layout) require_tmux; chip_layout "${2:-on}"; exit 0 ;;
  --chip-daemon) require_tmux; chip_daemon; exit 0 ;;
  # Run every status-interval from the chip line: restart a dead daemon.
  --chip-ensure)
    pid="$(tmux show-options -gqv @tmux_agents_chip_pid)"
    if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
      tmux run-shell -b "'$here/tmux-agents' --chip-daemon"
    fi
    exit 0
    ;;
  --initial-list)
    parse_prompt "${FZF_PROMPT:-}"
    rows="$(list_agents "$list_mode" "$list_scope" "${TMUX_AGENTS_LIST_CLIENT:-}")"
    if [ -n "${TMUX_AGENTS_SELECT_FILE:-}" ]; then
      # Write positioning before publishing rows; load runs after this reload.
      printf '%s' "$rows" | awk -v RS='\036' -v s="$TMUX_AGENTS_SELECT" '
        NR > 1 { sub(/^[^ ]+ +/, ""); if (index($0,s " ")==1 || index($0,"\n" s " ")) { print NR-1; exit } }
      ' >"$TMUX_AGENTS_SELECT_FILE"
    fi
    printf '%s' "$rows" | tr '\036' '\0'
    exit 0 ;;
  --list) require_tmux; parse_prompt "${FZF_PROMPT:-}"; list_agents "$list_mode" "$list_scope" "${TMUX_AGENTS_LIST_CLIENT:-}" | tr '\036' '\0'; exit 0 ;;
  # Popup body: a nested client on the hidden session, showing pane $2.
  # Detaching (prefix + d) brings back the list, on the same agent.
  --view)
    win="$(tmux display-message -p -t "$2" '#{window_id}')"
    name="$(pane_name "$2")"
    # Nesting needs TMUX unset; keep talking to this server, not the default one.
    sock="${TMUX%%,*}"
    sess="$(tmux display-message -p -t "$2" '#{session_name}')"
    ( unset TMUX; tmux -S "$sock" attach-session -t "=$sess" \; select-window -t "$win" )
    exec "$here/tmux-agents" --client "${3:-}" --select "$name" --scope "${4:-window}" --mode "${5:-sub}"
    ;;
  # Started by fzf on "start": keep the preview live by asking fzf (on its
  # --listen port) to refresh it. Ends when fzf exits and the port closes.
  --preview-loop)
    settings_get preview_secs TMUX_AGENTS_PREVIEW_SECS @tmux_agents_preview_secs 0.5
    while curl -fs -XPOST "http://localhost:${FZF_PORT:?}" -d refresh-preview >/dev/null 2>&1; do
      sleep "$preview_secs"
    done
    exit 0
    ;;
  # fzf "d": after the tmux prefix key (within 2s), prefix + d closes the
  # list, like it leaves an agent's view; otherwise d is just typed.
  # Preview of a closed sub agent: what reopening it would bring back.
  --closed-info)
    n="${2#closed:}"
    ensure_agent_ids
    valid_agent_id "$n" || die "invalid agent id: $n"
    parent="$(agent_name_by_id "$(record_get "$n" parent)")"
    [ -n "$parent" ] || parent="$(record_get "$n" parent_name)"
    printf '\033[1m%s\033[0m  closed, can be reopened\n\n' "$(record_get "$n" name)"
    printf '  ID       %s\n' "$n"
    printf '  agent    %s\n  dir      %s\n  parent   %s\n  session  %s\n\n' \
      "$(record_get "$n" kind)" "$(record_get "$n" dir)" "$parent" "$(record_get "$n" id)"
    printf 'enter: reopen it with its conversation, connected to %s\nctrl-o: reopen and jump there · ctrl-x: forget it\n' "$parent"
    exit 0
    ;;
  # ctrl-x: close a live agent, or forget a closed one.
  --dismiss)
    require_tmux
    case "${2:-}" in
      closed:*) n="${2#closed:}"; valid_agent_id "$n" || die "invalid agent id: $n"; rm -f "$(sessions_dir)/$n" ;;
      *) "$here/tmux-dismiss" "$(pane_name "$2")" ;;
    esac
    exit 0
    ;;
  --prefix-d)
    at="$(tmux show-options -gqv @tmux_agents_prefix_at)"
    tmux set-option -gu @tmux_agents_prefix_at 2>/dev/null || true
    if [ -n "$at" ] && [ $(( $(date +%s) - at )) -le 2 ]; then echo abort; else echo "put(d)"; fi
    exit 0
    ;;
  # ctrl-a remembers the named/sub view; ctrl-t changes only this picker
  # scope. Both preserve the other dimension in the prompt.
  --toggle|--toggle-scope)
    parse_prompt "${2:-}"
    if [ "$1" = --toggle ]; then
      if [ "$list_mode" = all ]; then list_mode=sub; else list_mode=all; fi
      tmux set-option -g @tmux_agents_list_mode "$list_mode"
    else
      if [ "$list_scope" = all ]; then list_scope=window; else list_scope=all; fi
    fi
    printf "change-prompt(%s)+reload('%s' --list)\n" "$(list_prompt "$list_mode" "$list_scope")" "$here/tmux-agents"
    exit 0
    ;;
  # status-right: "active subagents: N", plus how many rang for attention.
  --status)
    tmux list-panes -a -F '#{pane_id} #{?@parent,1,0} #{pane_dead} #{window_bell_flag} #{?#{==:#{@state},done},1,0}' | awk '
      $2 == 1 && !seen[$1]++ {
        if ($3 == 1 || $5 == 1) { d++; next }
        n++; if ($4 == 1) b++
      }
      END {
        printf "active subagents: %d", n
        if (b) printf " · %d needs you", b
        if (d) printf " · %d done", d
      }'
    exit 0
    ;;
  # alert-bell hook: tell every client when a hidden agent rings.
  --alert)
    is_agents_session "${2:-}" || exit 0
    for c in $(tmux list-clients -F '#{client_name}'); do
      is_agents_session "$(tmux display-message -p -c "$c" '#{session_name}')" && continue
      tmux display-message -c "$c" -d 5000 "agent ${3:-?} needs you (prefix + a)"
    done
    exit 0
    ;;
esac

client="" select="" scope=window mode=""
while [ $# -gt 0 ]; do
  case "$1" in
    --client) client="${2:-}"; shift 2 ;;
    --select) select="${2:-}"; shift 2 ;;
    --scope) scope="${2:-window}"; shift 2 ;;
    --mode) mode="${2:-sub}"; shift 2 ;;
    *) shift ;;
  esac
done
# The defaults lookup also validates the server; no separate list-sessions.
# Fetch picker defaults together, rather than another tmux process per option.
defaults="$(tmux display-message -p '#{?client_name,#{client_name},-}	#{?@tmux_agents_list_mode,#{@tmux_agents_list_mode},-}	#{prefix}')" || die "can't reach the tmux server"
IFS=$'\t' read -r default_client default_mode prefix <<<"$defaults"
[ "$default_client" != - ] || default_client=""
[ -n "$client" ] || client="$default_client"
command -v fzf >/dev/null 2>&1 || die "fzf is required"

self="$here/tmux-agents"
# Scope starts local on every fresh open; popup return passes both dimensions.
export TMUX_AGENTS_LIST_CLIENT="$client"
[ -n "$mode" ] || mode="$default_mode"
[ "$mode" = all ] || mode=sub
[ "$scope" = all ] || scope=window
prompt="agents · this window> "
[ "$mode" != all ] || prompt="all · this window> "
[ "$scope" != all ] || prompt="${prompt/this window/all windows}"
# The tmux prefix (C-b -> ctrl-b) arms "d" to close the list: prefix + d.
prefix_keys=()
case "$prefix" in
  C-[a-z]) pk="ctrl-${prefix#C-}"
    prefix_keys=(--bind "$pk:execute-silent(tmux set-option -g @tmux_agents_prefix_at \$(date +%s))" --bind "d:transform:'$self' --prefix-d") ;;
esac
selection=()
if [ -n "$select" ]; then
  export TMUX_AGENTS_SELECT="$select"
  TMUX_AGENTS_SELECT_FILE="$(mktemp "${TMPDIR:-/tmp}/tmux-agents-select.XXXXXX")"
  export TMUX_AGENTS_SELECT_FILE
  trap 'rm -f "$TMUX_AGENTS_SELECT_FILE"' EXIT
  # An empty initial load must not consume the positioning action.
  selection=(--bind "load:transform:if [ -s \"\$TMUX_AGENTS_SELECT_FILE\" ]; then read -r n < \"\$TMUX_AGENTS_SELECT_FILE\"; printf 'pos(%s)+unbind(load)' \"\$n\"; fi")
fi
out="$(fzf </dev/null --read0 --ansi --reverse --no-sort --header-lines=1 --with-nth=2.. --prompt="$prompt" \
  ${selection[@]+"${selection[@]}"} \
  ${prefix_keys[@]+"${prefix_keys[@]}"} \
  --with-shell 'bash -c' \
  --listen --bind "start:reload('$self' --initial-list)" \
  --bind "focus:execute-silent('$self' --preview-loop >/dev/null 2>&1 &)+unbind(focus)" \
  --footer=$'enter open · ^o jump (prefix+L back) · ^x dismiss\n^d clean done · ^a all/sub · ^t this/all windows · ^r refresh · prefix+d close' --footer-border=rounded \
  --preview "case {1} in closed:*) '$self' --closed-info {1} ;; *) tmux capture-pane -ep -J -t {1} -S -300 ;; esac" --preview-window='right,55%,follow' \
  --bind "ctrl-x:execute-silent('$self' --dismiss {1})+reload('$self' --list)" \
  --bind "ctrl-r:reload('$self' --list)" \
  --bind "ctrl-d:execute('$here/tmux-dismiss' --done)+reload('$self' --list)" \
  --bind "enter:transform:printf 'print(enter)+print(%s)+accept' \"\$FZF_PROMPT\"" \
  --bind "ctrl-o:transform:printf 'print(ctrl-o)+print(%s)+accept' \"\$FZF_PROMPT\"" \
  --bind "ctrl-t:transform:'$self' --toggle-scope \"\$FZF_PROMPT\"" \
  --bind "ctrl-a:transform:'$self' --toggle \"\$FZF_PROMPT\"")" || exit 0

key="$(printf '%s\n' "$out" | sed -n 1p)"
parse_prompt "$(printf '%s\n' "$out" | sed -n 2p)"
pane="$(printf '%s\n' "$out" | sed -n 3p | awk '{ print $1 }')"
[ -n "$pane" ] || exit 0

# A closed sub agent: reopen it with its conversation, connected to its
# old parent if that is still open, then show it like any other.
case "$pane" in
  closed:*)
    name="${pane#closed:}"
    if ! msg="$("$here/tmux-spawn" --resume-id "$name" 2>&1)"; then
      tmux display-message -c "$client" -d 6000 "$msg"
      exit 1
    fi
    pane="$(find_pane_by_id "$name")"
    [ -n "$pane" ] || exit 1
    ;;
esac
name="$(pane_name "$pane")"
session="$(tmux display-message -p -t "$pane" '#{session_name}')"

if [ "$key" != "ctrl-o" ] && is_agents_session "$session"; then
  # This script runs in a popup itself, so open the viewer once it closes.
  tmux run-shell -b "sleep 0.2; tmux display-popup -c '$client' -E -w 90% -h 90% -T ' $name  (prefix + d: back to the list) ' '$here/tmux-agents --view $pane $client $list_scope $list_mode'"
else
  tmux switch-client -c "$client" -t "$pane"
  tmux display-message -c "$client" -d 4000 "jumped to $name · prefix + L to go back"
fi
