#!/usr/bin/env bash
# Send a message into a connected pane, as if typed and submitted there.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
. "$here/lib.sh"

# Migration and first naming take exclusive locks, before any shared lock.
if [ "${TMUX_ASK_IDENTITY_LOCKED:-}" != 1 ]; then
  case "${1:-}" in -h|--help) ;; *) ensure_agent_ids ;; esac
fi
case "${1:-}" in
  --deliver|--retry|--kick|--pending|-h|--help) ;;
  *) if [ "${TMUX_ASK_IDENTITY_LOCKED:-}" != 1 ]; then
       case "${1:-}" in
         --*) case "$1" in --attempt|--retry-locked|--system-notice) internal=1 ;; *) internal=0 ;; esac ;;
         *) internal=0 ;;
       esac
       if [ "$internal" = 0 ]; then
         FROM_PANE=""
         args=("$@") initial_target=""
         for ((i=0; i<${#args[@]}; i++)); do
           case "${args[$i]}" in
             --from) i=$((i+1)); FROM_PANE="${args[$i]:-}" ;;
             --reply|--notice|--any) ;;
             --) break ;;
             *) if [ -z "$initial_target" ]; then initial_target="${args[$i]}"; else break; fi ;;
           esac
         done
         require_tmux
         initial_self="$(self_pane)"
         if [ -z "$(pane_name "$initial_self")" ]; then
           trusted_pane || die "this pane has no name; run tmux-connect first, or pass --from <your name>"
           auto_name "$initial_self" >/dev/null
         fi
         ensure_agent_id "$initial_self" >/dev/null
       fi
       agent_identity_lock shared env TMUX_ASK_IDENTITY_LOCKED=1 "$here/tmux-ask" "$@"
       exit $?
     fi ;;
esac
# Synchronous children inherit both the lock descriptor and its flag.
# start_deliverer explicitly clears the flag for server-launched workers.

settings_get ask_enter_delay TMUX_ASK_ENTER_DELAY @tmux_agents_ask_enter_delay 0.5
settings_get ask_queue_secs TMUX_ASK_QUEUE_SECS @tmux_agents_ask_queue_secs 1800
settings_get ask_copy_idle_secs TMUX_ASK_COPY_IDLE_SECS @tmux_agents_ask_copy_idle_secs 300
settings_get ask_max_lines TMUX_ASK_MAX_LINES @tmux_agents_ask_max_lines 60

# Paste $2 into pane $1 and submit it. Bracketed paste keeps multi-line
# text as one message. user_busy keeps us out of copy mode, where Enter
# would go to tmux instead of the program.
deliver() {
  local buf="tmux-ask-$$-${1#%}"
  printf '%s' "$2" | tmux load-buffer -b "$buf" - || return 1
  tmux paste-buffer -p -d -b "$buf" -t "$1" || return 1
  # settings_get assigns this variable by name.
  # shellcheck disable=SC2154
  sleep "$ask_enter_delay"
  tmux send-keys -t "$1" Enter
}

# Queued messages live in one place per user and tmux server, so the
# pane-mode-changed hook (running in the tmux server's environment) finds
# them too. Per server because pane ids repeat across servers: a message
# queued for %1 on one must never go to %1 on another. Names start with a
# timestamp, so sorting gives the send order.
queue_socket="${TMUX:-default}"
QUEUE_DIR="/tmp/tmux-agents-$(id -u)/queue/$(basename "${queue_socket%%,*}")"

# Metadata is data, never shell code. Legacy bodies supply missing identities.
queue_info() {
  local body="$1" meta header key value
  meta="${body%.msg.sending}"; meta="${meta%.*}.meta"
  case "$body" in *.msg.sending) meta="${body%.msg.sending}.meta" ;; esac
  from_id="" to_id="" from_pane="" from_name="" to_pane="" to_name="" kind="" queued_at=""
  if [ -f "$meta" ]; then
    while IFS='=' read -r key value; do
      case "$key" in
        from_id|to_id|from_pane|from_name|to_pane|to_name|kind|queued_at) printf -v "$key" '%s' "$value" ;;
      esac
    done < "$meta"
  fi
  header="$(head -n 1 "$body" 2>/dev/null || true)"
  [ -n "$from_name" ] || from_name="$(printf '%s\n' "$header" | sed -n 's/^\[.* from \([^ ]*\) to .* via tmux-ask].*/\1/p')"
  [ -n "$to_name" ] || to_name="$(printf '%s\n' "$header" | sed -n 's/^\[.* to \([^ ]*\) via tmux-ask].*/\1/p')"
  [ -n "$kind" ] || kind="$(printf '%s\n' "$header" | sed -n 's/^\[\([^ ]*\) from .*/\1/p')"
  [ -n "$queued_at" ] || { queued_at="$(basename "$body")"; queued_at="${queued_at%%-*}"; }
}

write_meta() {
  printf 'from_id=%s\nto_id=%s\nfrom_pane=%s\nfrom_name=%s\nto_pane=%s\nto_name=%s\nkind=%s\nqueued_at=%s\n' \
    "$from_id" "$to_id" "$from_pane" "$from_name" "$to_pane" "$to_name" "$kind" "$queued_at" > "$1"
}

queue_files() {
  find "$1" -type f \( -name '*.msg' -o -name '*.sending' -o -name '*.undelivered' \) 2>/dev/null | sort -t/ -k1 || true
}

# Serialize delivery and marker changes per receiver. All writers publish
# atomically; an interrupted delivery retains its body (at least once).
active_file=""
cleanup() {
  if [ -n "$active_file" ] && [ -f "${active_file%.msg}.sending" ]; then
    mv "${active_file%.msg}.sending" "$active_file" 2>/dev/null || true
  fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Kernel advisory locks cannot be stranded by SIGKILL. The owner PID is
# recorded for diagnosis; the inherited descriptor, not PID reuse or an
# unlink/check race, proves ownership. Never unlink these lock files.
with_lock() {
  local path="$1"; shift
  mkdir -p "$(dirname "$path")"
  perl -MFcntl=:flock -MIO::Handle -e '
    $^F = 255;
    my $path = shift @ARGV;
    open(my $lock, ">>", $path) or die "$path: $!";
    flock($lock, LOCK_EX | LOCK_NB) or exit 75;
    truncate($lock, 0) or die "truncate: $!";
    seek($lock, 0, 0); print $lock "$$\n";
    $lock->flush();
    exec @ARGV; die "exec: $!";
  ' "$path" "$@"
}

# Called under the pane lock. Keep the oldest escalated message visible
# until the last such message has gone, including multiple queued sends.
refresh_waiting() {
  local p="$1" f stamp oldest="" now previous
  now="$(date +%s)"
  for f in "$QUEUE_DIR"/*-"${p#%}".msg "$QUEUE_DIR"/*-"${p#%}".sending; do
    [ -f "$f" ] || continue
    stamp="$(basename "$f")"; stamp="${stamp%%-*}"
    case "$stamp" in ''|*[!0-9]*) continue ;; esac
    # settings_get assigns this variable by name.
    # shellcheck disable=SC2154
    if [ "$((now - stamp))" -ge "$ask_queue_secs" ]; then
      [ -n "$oldest" ] && [ "$oldest" -le "$stamp" ] || oldest="$stamp"
    fi
  done
  if [ -n "$oldest" ]; then
    previous="$(tmux show-options -pqv -t "$p" @msg_waiting_since 2>/dev/null || true)"
    agent_set_wait "$p" message "$oldest" 2>/dev/null || true
    if [ -z "$previous" ]; then
      "$here/tmux-agents" --chip-layout on >/dev/null 2>&1 || true
    fi
  else
    agent_set_wait "$p" message "" 2>/dev/null || true
  fi
}

start_deliverer() {
  local envs="" v val
  for v in TMUX_ASK_IDLE_SECS TMUX_ASK_QUEUE_SECS TMUX_ASK_COPY_IDLE_SECS TMUX_ASK_ENTER_DELAY; do
    val="${!v:-}"
    case "$val" in ''|*[!0-9.]*) continue ;; esac
    envs="$envs$v='$val' "
  done
  tmux run-shell -b "${envs}env -u TMUX_ASK_IDENTITY_LOCKED '$here/tmux-ask' --deliver '$1' '$2'"
}

# Publish metadata before the body, so readers never see a partial message.
# Keep the documented epoch-pid-pane filename, including batch retries.
publish() {
  local body="$1" stamp
  mkdir -p "$QUEUE_DIR"
  while :; do
    stamp="$(date +%s)"
    file="$QUEUE_DIR/$stamp-$(printf '%06d' $$)-${to_pane#%}.msg"
    [ -e "${file%.msg}.meta" ] || break
    sleep 1
  done
  write_meta "${file%.msg}.meta" || return 1
  printf '%s' "$body" > "$file.tmp" || return 1
  mv "$file.tmp" "$file" || return 1
}

bounce() {
  local source="$1" kept sender text reopen
  kept="${source%.msg}.undelivered"
  queue_info "$source"
  mv "$source" "$kept" || return 1
  sender=""
  if [ -n "$from_id" ]; then sender="$(find_pane_by_id "$from_id")"; fi
  text="your ${kind:-message} to ${to_name:-$to_pane} wasn't delivered: ${to_name:-$to_pane} is gone. The text is kept at $kept."
  reopen=""
  if valid_agent_id "$to_id"; then reopen="$(record_get "$to_id" id)"; fi
  [ -z "$reopen" ] || text="$text It will be delivered if $to_name is reopened; you needn't resend it."
  if [ -n "$sender" ] && [ "$from_name" != tmux-ask ]; then
    # A bounce is an ordinary durable notice, with no request-state effects.
    to_id="$from_id" from_id="" to_pane="$sender" to_name="$(pane_name "$sender")" from_pane="" from_name=tmux-ask kind=notice queued_at="$(date +%s)"
    publish "$(notice_body tmux-ask "$text" "$to_name")" || { printf 'bounce could not be queued; original retained at %s\n' "$kept" >&2; return 1; }
    start_deliverer "$to_pane" "$file" || printf 'notice retained at %s\n' "$file" >&2
  else
    for c in $(tmux list-clients -F '#{client_name}'); do
      tmux display-message -c "$c" -d 10000 "tmux-ask: $text" || true
    done
  fi
}

# Return 0 when handled, 1 while blocked. --kick skips only typing delay.
try_delivery() {
  with_lock "$QUEUE_DIR/.pane-${1#%}.lock" "$here/tmux-ask" --attempt "$@"
}

try_delivery_locked() {
  local peer="$1" source="$2" kick="${3:-0}" older sending restored
  # Holding the kernel lock proves no active paste owns these .sending files.
  for sending in "$QUEUE_DIR"/*-"${peer#%}".sending "$QUEUE_DIR"/*-"${peer#%}".msg.sending; do
    [ -f "$sending" ] || continue
    restored="${sending%.sending}"; restored="${restored%.msg}.msg"
    [ ! -e "$restored" ] || continue
    mv "$sending" "$restored" || return 1
  done
  [ -f "$source" ] || return 0
  queue_info "$source"
  if [ -z "$to_id" ] || ! pane_alive "$peer" || [ "$(pane_agent_id "$peer")" != "$to_id" ]; then
    if ! bounce "$source"; then return 1; fi
    return 0
  fi
  older="$(find "$QUEUE_DIR" -type f \( -name "*-${peer#%}.msg" -o -name "*-${peer#%}.sending" \) | sort | awk -v f="$source" '$0 < f { print; exit }')"
  if [ -n "$older" ] || { [ "$kick" = 0 ] && user_busy "$peer"; } ||
      [ "$(tmux display-message -p -t "$peer" '#{pane_in_mode}')" = 1 ]; then
    refresh_waiting "$peer"
    return 1
  fi
  sending="${source%.msg}.sending"
  active_file="$source"
  if ! mv "$source" "$sending"; then return 1; fi
  if deliver "$peer" "$(cat "$sending")"; then
    rm -f "$sending" "${source%.msg}.meta"
    active_file=""
    refresh_waiting "$peer"
    return 0
  fi
  # A failed paste/Enter is never considered delivered.
  cleanup
  active_file=""
  return 1
}

# Internal durable notice entry point for rename; no request/reply state effects.
if [ "${1:-}" = --system-notice ]; then
  [ "$#" = 3 ] || die 'invalid system notice'
  require_tmux
  to_pane="$(resolve_pane "$2")" to_name="$(pane_name "$2")"
  to_id="$(pane_agent_id "$to_pane")" from_id=""
  from_pane="" from_name=tmux-rename kind=notice queued_at="$(date +%s)"
  publish "$(notice_body tmux-rename "$3" "$to_name")"
  if ! try_delivery "$to_pane" "$file"; then
    start_deliverer "$to_pane" "$file" || printf 'notice retained at %s\n' "$file" >&2
  fi
  exit 0
fi

if [ "${1:-}" = --pending ]; then
  printf 'time\tsender\treceiver\tstate\tpath\n'
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    queue_info "$f"
    printf '%s\t%s\t%s\t%s\t%s\n' "$queued_at" "${from_name:-unknown}" "${to_name:-unknown}" "${f##*.}" "$f"
  done < <(queue_files "$(dirname "$QUEUE_DIR")")
  exit 0
fi

if [ "${1:-}" = --attempt ]; then
  shift
  try_delivery_locked "$@"
  exit $?
fi

if [ "${1:-}" = --retry ]; then
  shift
  require_tmux
  if with_lock "$(dirname "$QUEUE_DIR")/.retry.lock" "$here/tmux-ask" --retry-locked "$@"; then
    exit 0
  else
    rc=$?
    [ "$rc" = 75 ] || exit "$rc"
    printf 'retry already running; retained messages can be retried later\n'
    exit 0
  fi
fi

if [ "${1:-}" = --retry-locked ]; then
  shift
  filter=""
  if [ "${1:-}" = --to ] && [ -n "${2:-}" ]; then filter="$2"; shift 2; fi
  [ $# = 0 ] || die 'usage: tmux-ask --retry [--to NAME]'
  require_tmux
  filter_id=""
  if [ -n "$filter" ]; then
    filter_pane="$(find_pane "$filter")"
    if [ -z "$filter_pane" ]; then
      printf 'unplaced: receiver %s is absent\n' "$filter"
      exit 0
    fi
    filter_id="$(pane_agent_id "$filter_pane")"
  fi
  # Also restart persisted queued work whose worker failed to launch or died.
  for source in "$QUEUE_DIR"/*.msg "$QUEUE_DIR"/*.sending; do
    [ -f "$source" ] || continue
    queue_info "$source"
    [ -z "$filter" ] || { [ -n "$filter_id" ] && [ "$to_id" = "$filter_id" ]; } || continue
    receiver="$to_pane"
    if [ -z "$receiver" ]; then receiver="${source%.sending}"; receiver="${receiver%.msg}"; receiver="%${receiver##*-}"; fi
    source="${source%.sending}"; source="${source%.msg}.msg"
    if ! try_delivery "$receiver" "$source"; then start_deliverer "$receiver" "$source" || true; fi
  done
  # Never place another server's messages into a same-named agent here.
  while IFS= read -r source; do
    [ -f "$source" ] || continue
    queue_info "$source"
    [ -z "$filter" ] || { [ -n "$filter_id" ] && [ "$to_id" = "$filter_id" ]; } || continue
    receiver=""
    [ -z "$to_id" ] || receiver="$(find_pane_by_id "$to_id")"
    if [ -z "$to_id" ]; then
      printf 'unplaced: %s (legacy receiver identity cannot be established safely)\n' "$source"
      continue
    fi
    if [ -z "$receiver" ]; then
      printf 'unplaced: %s (receiver %s is absent)\n' "$source" "${to_name:-unknown}"
      continue
    fi
    # The batch lock serializes oldest-first retries, including legacy files.
    # Keep the source durable until its replacement is published.
    [ -f "$source" ] || continue
    to_pane="$receiver"
    publish "$(cat "$source")"
    rm -f "$source" "${source%.undelivered}.meta"
    # Reapply receiver state without attributing this retry to its caller.
    if [ "$kind" = request ]; then
      [ "$(tmux show-options -pqv -t "$receiver" @tracked)" != 1 ] || agent_set_state "$receiver" working
      tmux set-option -pu -t "$receiver" @waiting_on 2>/dev/null || true
      tmux set-option -pu -t "$receiver" @attention_since 2>/dev/null || true
    elif [ "$kind" = reply ]; then
      remove_word "$receiver" @awaiting "$from_id"
    fi
    if try_delivery "$receiver" "$file"; then
      printf 'retried: %s\n' "$source"
    else
      start_deliverer "$receiver" "$file" || true
      printf 'queued retry: %s -> %s\n' "$source" "$file"
    fi
  done < <({ find "$(dirname "$QUEUE_DIR")" -maxdepth 1 -name '*.undelivered' -type f 2>/dev/null; find "$QUEUE_DIR" -maxdepth 1 -name '*.undelivered' -type f 2>/dev/null; } | awk '{ n=$0; sub(/^.*\//,"",n); print n "\t" $0 }' | sort | cut -f2-)
  exit 0
fi

if [ "${1:-}" = --kick ]; then
  peer="$2"
  while IFS= read -r f; do
    f="${f%.sending}"; f="${f%.msg}.msg"
    try_delivery "$peer" "$f" 1 || true
  done < <(find "$QUEUE_DIR" -type f \( -name "*-${peer#%}.msg" -o -name "*-${peer#%}.sending" -o -name "*-${peer#%}.msg.sending" \) 2>/dev/null | sort)
  exit 0
fi

if [ "${1:-}" = --deliver ]; then
  peer="$2" source="$3" copy_idle=0
  while [ -f "$source" ] || [ -f "${source%.msg}.sending" ]; do
    try_delivery "$peer" "$source" && exit 0
    if [ "$(tmux display-message -p -t "$peer" '#{pane_in_mode}' 2>/dev/null)" = 1 ] && ! user_typing "$peer"; then
      copy_idle=$((copy_idle + 2))
    else
      copy_idle=0
    fi
    # settings_get assigns this variable by name.
    # shellcheck disable=SC2154
    limit="$ask_copy_idle_secs"
    if [ "$limit" -gt 0 ] 2>/dev/null && [ "$copy_idle" -ge "$limit" ]; then
      tmux send-keys -t "$peer" -X cancel 2>/dev/null || true
      for c in $(tmux list-clients -F '#{client_name}'); do
        tmux display-message -c "$c" -d 5000 "tmux-ask: $peer was left in copy mode for ${copy_idle}s; closed it to deliver a message" || true
      done
      copy_idle=0
    fi
    sleep 2
  done
  exit 0
fi

usage() {
  cat <<'EOF'
usage: tmux-ask [--from ME] [--any] <name> [--reply | --notice] [message...]

Sends message (arguments, or stdin if none) to the connected pane name
and submits it. Requests tell the receiver how to reply. Replies are
marked as needing no response, which stops endless back-and-forth.

  tmux-ask codex "review the diff in src/auth"
  tmux-ask --reply claude <<'MSG'
  multi-line reply
  MSG

--pending: list queued and undelivered messages, including legacy files
--retry [--to NAME]: retry undelivered messages by receiver name

--from ME: your own name (needed where $TMUX_PANE is wrong, e.g. Codex)
--notice:  a message that needs no answer (tmux-connect sends one when
           it connects agents in different windows)
--any:     send to a named pane you aren't connected to (the reply
           instructions include --any too)

Messages over TMUX_ASK_MAX_LINES (default 60) are saved to
$TMPDIR/tmux-agents/<you>/ and sent as the first 15 lines plus the path.
A sub agent that replies to its parent is marked done.
If the user is typing or scrolling in the receiver's pane, the message
is queued and sent once they stop typing or leave copy mode. A pane
left in copy mode with no keys for TMUX_ASK_COPY_IDLE_SECS is taken out
of it, so the message goes through.

Settings (environment overrides option):
  idle seconds: option @tmux_agents_ask_idle_secs, env TMUX_ASK_IDLE_SECS (8)
  escalation seconds: option @tmux_agents_ask_queue_secs, env TMUX_ASK_QUEUE_SECS (1800)
  copy-mode idle seconds: option @tmux_agents_ask_copy_idle_secs,
    env TMUX_ASK_COPY_IDLE_SECS (300; 0 = never leave automatically)
  long-message lines: option @tmux_agents_ask_max_lines, env TMUX_ASK_MAX_LINES (60)
  paste-to-Enter seconds: option @tmux_agents_ask_enter_delay, env TMUX_ASK_ENTER_DELAY (0.5)
EOF
}

target="" reply=0 notice=0 any=0 msg="" FROM_PANE=""
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --reply) reply=1; shift ;;
    --notice) notice=1; shift ;;
    --from) FROM_PANE="${2:-}"; shift 2 ;;
    --any) any=1; shift ;;
    --) shift; msg="$*"; break ;;
    -*) usage >&2; exit 1 ;;
    *)
      if [ -z "$target" ]; then target="$1"; shift
      else msg="$*"; break
      fi
      ;;
  esac
done

[ -n "$target" ] || { usage >&2; exit 1; }
if [ -z "$msg" ]; then
  [ -t 0 ] && die "no message (pass it as arguments or on stdin)"
  msg="$(cat)"
fi
[ -n "$msg" ] || die "empty message"

require_tmux
self="$(self_pane)"
me="$(pane_name "$self")"
if [ -z "$me" ]; then
  trusted_pane || die "this pane has no name; run tmux-connect first, or pass --from <your name>"
  me="$(auto_name "$self")" || die "couldn't give pane $self a name"
fi
if [ "$any" -eq 1 ]; then
  peer="$(resolve_pane "$target")"
  [ "$peer" != "$self" ] || die "that's you"
  [ -n "$(pane_name "$peer")" ] || die "pane $peer has no name, so it couldn't reply; name it with tmux-connect first"
else
  peer="$(resolve_peer "$self" "$target")"
fi

# Safety net for long messages: keep the full text in a file and send the
# head plus the path. Agents are asked to do this themselves with a summary.
# settings_get assigns this variable by name.
# shellcheck disable=SC2154
max="$ask_max_lines"
lines="$(printf '%s\n' "$msg" | wc -l | tr -d ' ')"
if [ "$lines" -gt "$max" ]; then
  dir="${TMPDIR:-/tmp}"; dir="${dir%/}/tmux-agents/$me"
  mkdir -p "$dir"
  file="$dir/$(date +%Y%m%d-%H%M%S)-to-$(pane_name "$peer").md"
  printf '%s\n' "$msg" > "$file"
  msg="$(printf '%s\n' "$msg" | head -n 15)
...
(Message was $lines lines; the full text is in $file. Read it from there.)"
fi

if [ "$notice" -eq 1 ]; then
  body="$(notice_body "$me" "$msg" "$(pane_name "$peer")")"
elif [ "$reply" -eq 1 ]; then
  body="$(reply_body "$me" "$msg" "$(pane_name "$peer")")"
else
  body="$(request_body "$me" "$msg" "$(pane_name "$peer")" "$([ "$any" -eq 1 ] && echo --any)")"
fi

# Persist even immediate sends, so a failed paste cannot lose the body.
kind=request
[ "$reply" -eq 0 ] || kind=reply
[ "$notice" -eq 0 ] || kind=notice
from_id="$(pane_agent_id "$self")" to_id="$(pane_agent_id "$peer")"
from_pane="$self" from_name="$me" to_pane="$peer" to_name="$(pane_name "$peer")" queued_at="$(date +%s)"
publish "$body"
queued=0
if ! try_delivery "$peer" "$file"; then
  start_deliverer "$peer" "$file" || printf 'delivery worker could not start; message retained at %s\n' "$file" >&2
  queued=1
fi

# Track sub agent state: replying to your parent means done; a new request
# means the receiver is working again. @awaiting lists who a pane is
# waiting to hear back from, so ending a turn to wait for them isn't
# mistaken for needing the user (tmux-agent-report --turn-end).
if [ "$notice" -eq 1 ]; then
  # A sub agent may end its turn after an FYI to its own parent. Keep
  # that pause distinct from needing the user; other notices imply no wait.
  if [ "$(tmux display-message -p -t "$self" '#{@parent}')" = "$peer" ]; then
    tmux set-option -p -t "$self" @waiting_on "$(pane_name "$peer") (after a notice)"
  fi
elif [ "$reply" -eq 1 ]; then
  [ "$(tmux display-message -p -t "$self" '#{@parent}')" != "$peer" ] || agent_set_state "$self" "done"
  remove_word "$peer" @awaiting "$from_id"
else
  [ "$(tmux show-options -pqv -t "$peer" @tracked)" != 1 ] || agent_set_state "$peer" working
  tmux set-option -pu -t "$peer" @waiting_on 2>/dev/null || true
  tmux set-option -pu -t "$peer" @attention_since 2>/dev/null || true
  add_word "$self" @awaiting "$to_id"
fi

kind=request
[ "$reply" -eq 0 ] || kind=reply
[ "$notice" -eq 0 ] || kind=notice
if [ "$queued" -eq 1 ]; then
  printf 'queued %s to %s: the user is typing or scrolling there; it will be delivered once they stop\n' "$kind" "$(label "$peer")"
else
  printf 'sent %s to %s\n' "$kind" "$(label "$peer")"
fi
