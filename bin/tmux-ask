#!/usr/bin/env bash
# Send a message into a connected pane, as if typed and submitted there.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
. "$here/lib.sh"
. "$here/notes-lib.sh"

# Migration and first naming take exclusive locks, before any shared lock.
if [ "${TMUX_ASK_IDENTITY_LOCKED:-}" != 1 ]; then
  case "${1:-}" in -h|--help) ;; *) ensure_agent_ids; migrate_turn_state ;; esac
fi
case "${1:-}" in
  --deliver|--retry|--kick|--pending|-h|--help) ;;
  *) if [ "${TMUX_ASK_IDENTITY_LOCKED:-}" != 1 ]; then
       case "${1:-}" in
         --*) case "$1" in --attempt|--retry-locked|--system-notice|--notes-digest|--notes-digest-turn|--notes-digest-locked) internal=1 ;; *) internal=0 ;; esac ;;
         *) internal=0 ;;
       esac
       if [ "$internal" = 0 ]; then
         FROM_PANE=""
         args=("$@") initial_target=""
         for ((i=0; i<${#args[@]}; i++)); do
           case "${args[$i]}" in
             --from) i=$((i+1)); FROM_PANE="${args[$i]:-}" ;;
             --request-id|--mission|--message-file|--summary) i=$((i+1)) ;;
             --reply|--notice|--note|--any) ;;
             --) break ;;
             *) if [ -z "$initial_target" ]; then initial_target="${args[$i]}"; else break; fi ;;
           esac
         done
         require_tmux
         initial_self="$(self_pane)"
         require_agent_pane "$initial_self"
         if [ -z "$(pane_name "$initial_self")" ]; then
           trusted_pane || die "this pane has no name; run tmux-connect first, or pass --from <your name>"
           auto_name "$initial_self" >/dev/null
         fi
         ensure_agent_id "$initial_self" >/dev/null
       fi
       agent_identity_lock shared env TMUX_ASK_IDENTITY_LOCKED=1 "$here/tmux-ask" "$@"
       exit $?
     fi ;;
esac
# Synchronous children inherit both the lock descriptor and its flag.
# start_deliverer explicitly clears the flag for server-launched workers.

settings_get ask_enter_delay TMUX_ASK_ENTER_DELAY @tmux_agents_ask_enter_delay 0.5
settings_get ask_queue_secs TMUX_ASK_QUEUE_SECS @tmux_agents_ask_queue_secs 1800
settings_get ask_copy_idle_secs TMUX_ASK_COPY_IDLE_SECS @tmux_agents_ask_copy_idle_secs 300

# Paste $2 into pane $1 and submit it. Bracketed paste keeps multi-line
# text as one message. user_busy keeps us out of copy mode, where Enter
# would go to tmux instead of the program.
deliver() {
  local buf="tmux-ask-$$-${1#%}"
  (require_agent_pane "$1") || return 1
  printf '%s' "$2" | tmux load-buffer -b "$buf" - || return 1
  (require_agent_pane "$1") || { tmux delete-buffer -b "$buf"; return 1; }
  tmux paste-buffer -p -d -b "$buf" -t "$1" || return 1
  # settings_get assigns this variable by name.
  # shellcheck disable=SC2154
  sleep "$ask_enter_delay"
  (require_agent_pane "$1") || return 1
  tmux send-keys -t "$1" Enter
}

# Queued messages live in one place per user and tmux server, so the
# pane-mode-changed hook (running in the tmux server's environment) finds
# them too. Per server because pane ids repeat across servers: a message
# queued for %1 on one must never go to %1 on another. Names start with a
# timestamp, so sorting gives the send order.
QUEUE_DIR="$(message_queue_dir)"

# Metadata is data, never shell code. Legacy bodies supply missing identities.
queue_info() {
  local body="$1" meta header key value
  meta="${body%.msg.sending}"; meta="${meta%.*}.meta"
  case "$body" in *.msg.sending) meta="${body%.msg.sending}.meta" ;; esac
  from_id="" to_id="" from_pane="" from_name="" to_pane="" to_name="" kind="" queued_at="" message_id=""
  if [ -f "$meta" ]; then
    while IFS='=' read -r key value; do
      case "$key" in
        from_id|to_id|from_pane|from_name|to_pane|to_name|kind|queued_at|message_id) printf -v "$key" '%s' "$value" ;;
      esac
    done < "$meta"
  fi
  header="$(head -n 1 "$body" 2>/dev/null || true)"
  [ -n "$from_name" ] || from_name="$(printf '%s\n' "$header" | sed -n 's/^\[.* from \([^ ]*\) to .* via tmux-ask[^]]*].*/\1/p')"
  [ -n "$to_name" ] || to_name="$(printf '%s\n' "$header" | sed -n 's/^\[.* to \([^ ]*\) via tmux-ask[^]]*].*/\1/p')"
  [ -n "$kind" ] || kind="$(printf '%s\n' "$header" | sed -n 's/^\[\([^ ]*\) from .*/\1/p')"
  [ -n "$queued_at" ] || { queued_at="$(basename "$body")"; queued_at="${queued_at%%-*}"; }
}

write_meta() {
  printf 'from_id=%s\nto_id=%s\nfrom_pane=%s\nfrom_name=%s\nto_pane=%s\nto_name=%s\nkind=%s\nqueued_at=%s\n' \
    "$from_id" "$to_id" "$from_pane" "$from_name" "$to_pane" "$to_name" "$kind" "$queued_at" > "$1"
  printf 'message_id=%s\n' "${message_id:-}" >> "$1"
}

queue_files() {
  find "$1" -type f \( -name '*.msg' -o -name '*.sending' -o -name '*.undelivered' \) 2>/dev/null | sort -t/ -k1 || true
}

# Serialize delivery and marker changes per receiver. All writers publish
# atomically; an interrupted delivery retains its body (at least once).
active_file=""
cleanup() {
  if [ -n "$active_file" ] && [ -f "${active_file%.msg}.sending" ]; then
    mv "${active_file%.msg}.sending" "$active_file" 2>/dev/null || true
  fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Called under the pane lock. Keep the oldest escalated message visible
# until the last such message has gone, including multiple queued sends.
refresh_waiting() {
  local p="$1" f stamp oldest="" now previous
  now="$(date +%s)"
  for f in "$QUEUE_DIR"/*-"${p#%}".msg "$QUEUE_DIR"/*-"${p#%}".sending; do
    [ -f "$f" ] || continue
    stamp="$(basename "$f")"; stamp="${stamp%%-*}"
    case "$stamp" in ''|*[!0-9]*) continue ;; esac
    # settings_get assigns this variable by name.
    # shellcheck disable=SC2154
    if [ "$((now - stamp))" -ge "$ask_queue_secs" ]; then
      [ -n "$oldest" ] && [ "$oldest" -le "$stamp" ] || oldest="$stamp"
    fi
  done
  if [ -n "$oldest" ]; then
    previous="$(tmux show-options -pqv -t "$p" @msg_waiting_since 2>/dev/null || true)"
    agent_set_wait "$p" message "$oldest" 2>/dev/null || true
    if [ -z "$previous" ]; then
      "$here/tmux-agents" --chip-layout on >/dev/null 2>&1 || true
    fi
  else
    agent_set_wait "$p" message "" 2>/dev/null || true
  fi
}

start_deliverer() {
  local envs="" v val
  for v in TMUX_ASK_IDLE_SECS TMUX_ASK_QUEUE_SECS TMUX_ASK_COPY_IDLE_SECS TMUX_ASK_ENTER_DELAY; do
    val="${!v:-}"
    case "$val" in ''|*[!0-9.]*) continue ;; esac
    envs="$envs$v='$val' "
  done
  tmux run-shell -b "${envs}env -u TMUX_ASK_IDENTITY_LOCKED '$here/tmux-ask' --deliver '$1' '$2'"
}

# Publish metadata before the body, so readers never see a partial message.
# Keep the documented epoch-pid-pane filename, including batch retries.
publish() {
  local body="$1" stamp
  mkdir -p "$QUEUE_DIR"
  while :; do
    stamp="$(date +%s)"
    file="$QUEUE_DIR/$stamp-$(printf '%06d' $$)-${to_pane#%}.msg"
    [ -e "${file%.msg}.meta" ] || break
    sleep 1
  done
  write_meta "${file%.msg}.meta" || return 1
  printf '%s' "$body" > "$file.tmp" || return 1
  mv "$file.tmp" "$file" || return 1
}

bounce() {
  local source="$1" reason="${2:-is gone}" kept sender text reopen
  kept="${source%.msg}.undelivered"
  queue_info "$source"
  mv "$source" "$kept" || return 1
  sender=""
  if [ -n "$from_id" ]; then sender="$(find_pane_by_id "$from_id")"; fi
  text="your ${kind:-message} to ${to_name:-$to_pane} wasn't delivered: ${to_name:-$to_pane} $reason. The text is kept at $kept."
  reopen=""
  if valid_agent_id "$to_id"; then reopen="$(record_get "$to_id" id)"; fi
  if [ -n "$reopen" ]; then text="$text It will be delivered if $to_name is reopened; you needn't resend it."
  fi
  if [ -n "$sender" ] && [ "$from_name" != tmux-ask ] &&
      [ "$(tmux show-options -pqv -t "$sender" @shell)" != 1 ]; then
    # A bounce is an ordinary durable notice, with no request-state effects.
    to_id="$from_id" from_id="" to_pane="$sender" to_name="$(pane_name "$sender")" from_pane="" from_name=tmux-ask kind=notice message_id="$(new_message_id)" queued_at="$(date +%s)"
    publish "$(notice_body tmux-ask "$text" "$to_name" "$message_id")" || { printf 'bounce could not be queued; original retained at %s\n' "$kept" >&2; return 1; }
    start_deliverer "$to_pane" "$file" || printf 'notice retained at %s\n' "$file" >&2
  else
    for c in $(tmux list-clients -F '#{client_name}'); do
      tmux display-message -c "$c" -d 10000 "tmux-ask: $text" || true
    done
  fi
}

# Return 0 when handled, 1 while blocked. --kick skips only typing delay.
try_delivery() {
  with_lock "$QUEUE_DIR/.pane-${1#%}.lock" "$here/tmux-ask" --attempt "$@"
}

try_delivery_locked() {
  local peer="$1" source="$2" kick="${3:-0}" older sending restored
  # Holding the kernel lock proves no active paste owns these .sending files.
  for sending in "$QUEUE_DIR"/*-"${peer#%}".sending "$QUEUE_DIR"/*-"${peer#%}".msg.sending; do
    [ -f "$sending" ] || continue
    restored="${sending%.sending}"; restored="${restored%.msg}.msg"
    [ ! -e "$restored" ] || continue
    mv "$sending" "$restored" || return 1
  done
  [ -f "$source" ] || return 0
  queue_info "$source"
  if ! (require_agent_pane "$peer"); then
    bounce "$source" 'is a shell, not an agent' || return 1
    return 0
  fi
  if [ -z "$to_id" ] || ! pane_alive "$peer" || [ "$(pane_agent_id "$peer")" != "$to_id" ]; then
    if ! bounce "$source"; then return 1; fi
    return 0
  fi
  older="$(find "$QUEUE_DIR" -type f \( -name "*-${peer#%}.msg" -o -name "*-${peer#%}.sending" \) | sort | awk -v f="$source" '$0 < f { print; exit }')"
  if [ -n "$older" ] || { [ "$kick" = 0 ] && user_busy "$peer"; } ||
      [ "$(tmux display-message -p -t "$peer" '#{pane_in_mode}')" = 1 ]; then
    refresh_waiting "$peer"
    return 1
  fi
  sending="${source%.msg}.sending"
  active_file="$source"
  if ! mv "$source" "$sending"; then return 1; fi
  if deliver "$peer" "$(cat "$sending")"; then
    rm -f "$sending" "${source%.msg}.meta"
    if [ "$kind" = request ] && [ -n "$from_id" ]; then
      tmux set-option -p -t "$peer" @last_requester "$from_id"
    fi
    turn_message_delivered "$peer" "$kind" "$message_id" || true
    active_file=""
    refresh_waiting "$peer"
    return 0
  fi
  # A failed paste/Enter is never considered delivered.
  cleanup
  active_file=""
  return 1
}

# Digest delivery never enters the durable queue. Lock order matches delivery:
# pane delivery lock, then turn lock. The locked event avoids taking it twice.
notes_digest_ready() {
  [ "$(pane_agent_id "$1")" = "$2" ] || return 1
  [ "$(tmux display-message -p -t "$1" '#{pane_dead}')" = 0 ] || return 1
  [ "$(tmux show-options -pqv -t "$1" @tracked)" = 1 ] || return 1
  [ "$(tmux show-options -pqv -t "$1" @shell)" != 1 ] || return 1
  case "$(tmux show-options -pqv -t "$1" @state)" in idle|done) ;; *) return 1 ;; esac
  local key
  for key in perm_since asking explicit_needs_you; do
    [ -z "$(tmux show-options -pqv -t "$1" "@$key")" ] || return 1
  done
  ! user_busy "$1"
}
if [ "${1:-}" = --notes-digest ]; then
  [ "$#" = 5 ] || die 'invalid notes digest'
  require_tmux
  with_lock "$QUEUE_DIR/.pane-${2#%}.lock" "$here/tmux-ask" --notes-digest-turn "${@:2}"
  exit $?
fi
if [ "${1:-}" = --notes-digest-turn ]; then
  perl -MFcntl=:flock -e '
    my ($path, @cmd) = @ARGV;
    open(my $lock, ">>", $path) or die "$!";
    flock($lock, LOCK_EX) or die "$!";
    system(@cmd); exit($? == -1 ? 1 : $? >> 8);
  ' "$(sessions_dir)/.turn-$2.lock" "$here/tmux-ask" --notes-digest-locked "${@:2}"
  exit $?
fi
if [ "${1:-}" = --notes-digest-locked ]; then
  peer="$2" receiver_id="$3" text="$4"
  notes_digest_ready "$peer" "$receiver_id" || exit 1
  message_id="$(new_message_id)"
  body="$(notice_body tmux-agents "$text" "$(pane_name "$peer")" "$message_id")"
  buf="tmux-notes-digest-$$"
  printf '%s' "$body" | tmux load-buffer -b "$buf" - || exit 1
  notes_digest_ready "$peer" "$receiver_id" || { tmux delete-buffer -b "$buf"; exit 1; }
  tmux paste-buffer -p -d -b "$buf" -t "$peer" || exit 1
  sleep "$ask_enter_delay"
  notes_digest_ready "$peer" "$receiver_id" || exit 1
  tmux send-keys -t "$peer" Enter || exit 1
  notes_mark_read "$receiver_id" "$5"
  sent_at="$(date +%s)"
  tmux set-option -p -t "$peer" @notes_digest_at "$sent_at" \; \
    set-option -p -t "$peer" @notes_digest_sent_at "$sent_at"
  _turn_event "$peer" delivered notice "$message_id"
  exit 0
fi

# Internal durable notice entry point for rename and startup reports.
# The optional sender names the tool.
if [ "${1:-}" = --system-notice ]; then
  [ "$#" = 3 ] || [ "$#" = 4 ] || die 'invalid system notice'
  sender="${4:-tmux-rename}"
  case "$sender" in tmux-rename|tmux-agents) ;; *) die 'invalid system notice sender' ;; esac
  require_tmux
  to_pane="$(resolve_pane "$2")" to_name="$(pane_name "$2")"
  require_agent_pane "$to_pane"
  to_id="$(pane_agent_id "$to_pane")" from_id=""
  from_pane="" from_name="$sender" kind=notice message_id="$(new_message_id)" queued_at="$(date +%s)"
  publish "$(notice_body "$sender" "$3" "$to_name" "$message_id")"
  if ! try_delivery "$to_pane" "$file"; then
    start_deliverer "$to_pane" "$file" || printf 'notice retained at %s\n' "$file" >&2
  fi
  exit 0
fi

if [ "${1:-}" = --pending ]; then
  printf 'time\tsender\treceiver\tstate\tpath\n'
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    queue_info "$f"
    printf '%s\t%s\t%s\t%s\t%s\n' "$queued_at" "${from_name:-unknown}" "${to_name:-unknown}" "${f##*.}" "$f"
  done < <(queue_files "$(dirname "$QUEUE_DIR")")
  exit 0
fi

if [ "${1:-}" = --attempt ]; then
  shift
  try_delivery_locked "$@"
  exit $?
fi

if [ "${1:-}" = --retry ]; then
  shift
  require_tmux
  # Retry scans this socket's messages. Serialize the whole batch locally
  # and wait for its predecessor, so a resumed receiver is never skipped.
  with_lock "$QUEUE_DIR/.retry.lock" --blocking "$here/tmux-ask" --retry-locked "$@"
  exit $?
fi

if [ "${1:-}" = --retry-locked ]; then
  shift
  filter=""
  if [ "${1:-}" = --to ] && [ -n "${2:-}" ]; then filter="$2"; shift 2; fi
  [ $# = 0 ] || die 'usage: tmux-ask --retry [--to NAME]'
  require_tmux
  filter_id=""
  if [ -n "$filter" ]; then
    filter_pane="$(find_pane "$filter")"
    if [ -z "$filter_pane" ]; then
      printf 'unplaced: receiver %s is absent\n' "$filter"
      exit 0
    fi
    require_agent_pane "$filter_pane"
    filter_id="$(pane_agent_id "$filter_pane")"
  fi
  # Also restart persisted queued work whose worker failed to launch or died.
  for source in "$QUEUE_DIR"/*.msg "$QUEUE_DIR"/*.sending; do
    [ -f "$source" ] || continue
    queue_info "$source"
    [ -z "$filter" ] || { [ -n "$filter_id" ] && [ "$to_id" = "$filter_id" ]; } || continue
    receiver="$to_pane"
    if [ -z "$receiver" ]; then receiver="${source%.sending}"; receiver="${receiver%.msg}"; receiver="%${receiver##*-}"; fi
    source="${source%.sending}"; source="${source%.msg}.msg"
    if ! try_delivery "$receiver" "$source"; then start_deliverer "$receiver" "$source" || true; fi
  done
  # Never place another server's messages into a same-named agent here.
  while IFS= read -r source; do
    [ -f "$source" ] || continue
    queue_info "$source"
    [ -z "$filter" ] || { [ -n "$filter_id" ] && [ "$to_id" = "$filter_id" ]; } || continue
    receiver=""
    [ -z "$to_id" ] || receiver="$(find_pane_by_id "$to_id")"
    if [ -z "$to_id" ]; then
      printf 'unplaced: %s (legacy receiver identity cannot be established safely)\n' "$source"
      continue
    fi
    if [ -z "$receiver" ]; then
      printf 'unplaced: %s (receiver %s is absent)\n' "$source" "${to_name:-unknown}"
      continue
    fi
    if ! (require_agent_pane "$receiver"); then
      printf 'unplaced: %s (receiver is a shell, not an agent)\n' "$source"
      continue
    fi
    # The batch lock serializes oldest-first retries, including legacy files.
    # Keep the source durable until its replacement is published.
    [ -f "$source" ] || continue
    to_pane="$receiver"
    publish "$(cat "$source")"
    rm -f "$source" "${source%.undelivered}.meta"

    if try_delivery "$receiver" "$file"; then
      printf 'retried: %s\n' "$source"
    else
      start_deliverer "$receiver" "$file" || true
      printf 'queued retry: %s -> %s\n' "$source" "$file"
    fi
  done < <({ find "$(dirname "$QUEUE_DIR")" -maxdepth 1 -name '*.undelivered' -type f 2>/dev/null; find "$QUEUE_DIR" -maxdepth 1 -name '*.undelivered' -type f 2>/dev/null; } | awk '{ n=$0; sub(/^.*\//,"",n); print n "\t" $0 }' | sort | cut -f2-)
  exit 0
fi

if [ "${1:-}" = --kick ]; then
  peer="$2"
  while IFS= read -r f; do
    f="${f%.sending}"; f="${f%.msg}.msg"
    try_delivery "$peer" "$f" 1 || true
  done < <(find "$QUEUE_DIR" -type f \( -name "*-${peer#%}.msg" -o -name "*-${peer#%}.sending" -o -name "*-${peer#%}.msg.sending" \) 2>/dev/null | sort)
  exit 0
fi

if [ "${1:-}" = --deliver ]; then
  peer="$2" source="$3" copy_idle=0
  while [ -f "$source" ] || [ -f "${source%.msg}.sending" ]; do
    try_delivery "$peer" "$source" && exit 0
    if [ "$(tmux display-message -p -t "$peer" '#{pane_in_mode}' 2>/dev/null)" = 1 ] && ! user_typing "$peer"; then
      copy_idle=$((copy_idle + 2))
    else
      copy_idle=0
    fi
    # settings_get assigns this variable by name.
    # shellcheck disable=SC2154
    limit="$ask_copy_idle_secs"
    if [ "$limit" -gt 0 ] 2>/dev/null && [ "$copy_idle" -ge "$limit" ]; then
      tmux send-keys -t "$peer" -X cancel 2>/dev/null || true
      for c in $(tmux list-clients -F '#{client_name}'); do
        tmux display-message -c "$c" -d 5000 "tmux-ask: $peer was left in copy mode for ${copy_idle}s; closed it to deliver a message" || true
      done
      copy_idle=0
    fi
    sleep 2
  done
  exit 0
fi

usage() {
  cat <<'EOF'
usage: tmux-ask [--from ME] [--any] [name] [--reply | --notice | --note] [--summary TEXT] [message...]

Sends message (arguments, stdin, or --message-file) to the connected pane name
and submits it. Requests tell the receiver how to reply. Replies are
marked as needing no response, which stops endless back-and-forth.

  tmux-ask codex "review the diff in src/auth"
  tmux-ask --reply -- "Review complete."
  tmux-ask --summary "Review complete; details attached." codex "Full report..."

--pending: list queued and undelivered messages, including legacy files
--retry [--to NAME]: retry undelivered messages by receiver name

--reply: reply to the latest delivered requester when no name is supplied;
         use --reply -- "body" for nameless positional text, or stdin
--summary TEXT: retain the positional or stdin body for 7 days, delivering
                TEXT plus a tmux-read pointer; conflicts with --message-file
--request-id ID: deprecated; accepted and ignored
--message-file PATH: use a readable regular text file (max 1 MiB; no symlinks)
              alone: paste the full file as the message, without archiving it
              with positional message text: that text is the summary; retain
              the file for 7 days and append a tmux-read pointer to the summary
              stdin is ignored in both modes; put options before the summary
--from ME: your own name (needed where $TMUX_PANE is wrong, e.g. Codex)
--note:    store a quiet note without pasting or starting a turn
--mission ID: with --note, append progress to the local mission log
--notice:  a message that needs no answer (tmux-connect sends one when
           it connects agents in different windows)
--any:     send to a named pane you aren't connected to (the reply
           instructions include --any too)

Messages are never truncated or split. Choose --summary TEXT
when the full text would flood the receiver. Otherwise send it in full.
Replies change message formatting; turn hooks determine completion.
If the user is typing or scrolling in the receiver's pane, the message
is queued and sent once they stop typing or leave copy mode. A pane
left in copy mode with no keys for TMUX_ASK_COPY_IDLE_SECS is taken out
of it, so the message goes through.

Settings (environment overrides option):
  idle seconds: option @tmux_agents_ask_idle_secs, env TMUX_ASK_IDLE_SECS (8)
  escalation seconds: option @tmux_agents_ask_queue_secs, env TMUX_ASK_QUEUE_SECS (1800)
  copy-mode idle seconds: option @tmux_agents_ask_copy_idle_secs,
    env TMUX_ASK_COPY_IDLE_SECS (300; 0 = never leave automatically)
  paste-to-Enter seconds: option @tmux_agents_ask_enter_delay, env TMUX_ASK_ENTER_DELAY (0.5)
EOF
}

target="" reply=0 notice=0 note=0 mission="" any=0 msg="" full_message="" FROM_PANE="" message_file="" message_file_given=0 positional_message=0 summary="" summary_given=0
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --request-id) [ "$#" -ge 2 ] || die "--request-id needs an ID"; printf "%s\n" "tmux-ask: --request-id is no longer needed" >&2; shift 2 ;;
    --message-file) [ "$#" -ge 2 ] || die "--message-file needs a path"; [ "$message_file_given" -eq 0 ] || die "--message-file may only be used once"; message_file="$2"; message_file_given=1; shift 2 ;;
    --summary) [ "$#" -ge 2 ] && [ -n "$2" ] || die "--summary needs text"; [ "$summary_given" -eq 0 ] || die "--summary may only be used once"; summary="$2"; summary_given=1; shift 2 ;;
    --reply) reply=1; shift ;;
    --notice) notice=1; shift ;;
    --note) note=1; shift ;;
    --mission) [ "$#" -ge 2 ] && [ -n "$2" ] || die "--mission needs an ID"; mission="$2"; shift 2 ;;
    --from) FROM_PANE="${2:-}"; shift 2 ;;
    --any) any=1; shift ;;
    --) shift; [ "$#" -eq 0 ] || positional_message=1; msg="$*"; break ;;
    -*) usage >&2; exit 1 ;;
    *)
      if [ -z "$target" ]; then target="$1"; shift
      else positional_message=1; msg="$*"; break
      fi
      ;;
  esac
done

[ -n "$target" ] || [ "$reply" -eq 1 ] || { usage >&2; exit 1; }
[ "$note" -eq 0 ] || [ "$((reply + notice))" -eq 0 ] || die '--note conflicts with --reply and --notice'
[ -z "$mission" ] || [ "$note" -eq 1 ] || die '--mission requires --note'
[ "$summary_given" -eq 0 ] || [ "$message_file_given" -eq 0 ] || die "--summary conflicts with --message-file"
# Read-only preflight before retaining a summary or publishing a note.
if [ -n "$mission" ]; then
  "$here/tmux-agents-mission" show --from "${FROM_PANE:-tmux-ask}" --log 0 -- "$mission" >/dev/null ||
    die "cannot read mission '$mission'; note was not saved"
fi
missing_message() {
  if [ "$reply" -eq 1 ] && [ -n "$target" ] && [ "$positional_message" -eq 0 ]; then
    die 'reply body missing; use --reply -- "text" or --reply NAME "text"'
  fi
  die "$1"
}
if [ "$message_file_given" -eq 1 ]; then
  read_message_file full_message "$message_file"
  [ -n "$full_message" ] || die "empty message"
  if [ "$positional_message" -eq 0 ]; then msg="$full_message"; fi
else
  if [ -z "$msg" ]; then
    [ -t 0 ] && missing_message "no message (pass it as arguments or on stdin)"
    # Keep trailing newlines too: the archived stdin body is the full message.
    msg="$(cat; printf '\001')"
    msg="${msg%$'\001'}"
  fi
fi
[ -n "$msg" ] || missing_message "empty message"

require_tmux
self="$(self_pane)"
require_agent_pane "$self"
if [ -z "$target" ]; then
  requester="$(tmux show-options -pqv -t "$self" @last_requester)"
  [ -n "$requester" ] || die 'no remembered requester; use --reply NAME'
  target="$(find_pane_by_id "$requester")"
  [ -n "$target" ] || die 'latest requester is unavailable; use --reply NAME'
fi
# Check named shells before peer filtering hides stale connections.
named_target="$(find_pane "$target")"
[ -z "$named_target" ] || require_agent_pane "$named_target"
me="$(pane_name "$self")"
if [ -z "$me" ]; then
  trusted_pane || die "this pane has no name; run tmux-connect first, or pass --from <your name>"
  me="$(auto_name "$self")" || die "couldn't give pane $self a name"
fi
from_id="$(pane_agent_id "$self")"
peer="" to_id="" to_name=""
if [ "$note" -eq 1 ] && [ -z "$named_target" ] && ! is_target "$target"; then
  ids="$(record_ids_by_name "$target")"
  if valid_agent_id "$target" && [ -f "$(sessions_dir)/$target" ]; then ids="$target"; fi
  [ -n "$ids" ] || die "no agent named '$target'"
  [ "$(printf '%s\n' "$ids" | wc -l | tr -d ' ')" = 1 ] || die "ambiguous closed agent '$target'; use its agent ID"
  to_id="$ids"; to_name="$(record_get "$to_id" name)"
  [ -z "$(find_pane_by_id "$to_id")" ] && [ -n "$(record_get "$to_id" closed)" ] || die "agent '$target' has no live pane or closed record"
  [ "$to_id" != "$from_id" ] || die "that's you"
  if [ "$any" -eq 0 ]; then
    authorized=0
    case " $(closed_names "$self") " in *" $to_id "*) authorized=1 ;; esac
    [ "$(record_get "$to_id" parent)" != "$from_id" ] || authorized=1
    [ "$(record_get "$from_id" parent)" != "$to_id" ] || authorized=1
    [ "$authorized" -eq 1 ] || die "'$target' is not connected; use --any for an unrelated closed agent"
  fi
else
  if [ "$any" -eq 1 ]; then
    peer="$(resolve_pane "$target")"
    require_agent_pane "$peer"
    [ "$peer" != "$self" ] || die "that's you"
    [ -n "$(pane_name "$peer")" ] || die "pane $peer has no name, so it couldn't reply; name it with tmux-connect first"
  else
    if is_target "$target"; then
      candidate="$(resolve_pane "$target")"
      require_agent_pane "$candidate"
    fi
    peer="$(resolve_peer "$self" "$target")"
  fi
  to_id="$(pane_agent_id "$peer")" to_name="$(pane_name "$peer")"
fi

message_id="$(new_message_id)"

# --summary archives the body; the legacy file plus positional summary also works.
if [ "$summary_given" -eq 1 ]; then
  full_message="$msg"
  msg="$summary"
fi
# Build the pointer first, but do not retain the body until mission logging
# succeeds. A busy or unwritable mission must not leave an orphan attachment.
retain=0
if [ "$summary_given" -eq 1 ] || { [ "$message_file_given" -eq 1 ] && [ "$positional_message" -eq 1 ]; }; then
  retain=1
  msg="$msg
Read the full message here: tmux-read $message_id"
fi
if [ -n "$mission" ]; then
  mission_text="$(printf '%s' "$msg" | tr '\n\r\t' '   ')"
  "$here/tmux-agents-mission" log --from "$me" --kind progress -- "$mission" "$mission_text" ||
    die "cannot log mission '$mission'; note was not saved"
fi
[ "$retain" -eq 0 ] || store_message "$full_message" "$message_id"

if [ "$note" -eq 1 ]; then
  notes_write "$to_id" "$from_id" "$me" "$message_id" "$msg"
  notes_start_digest "$to_id"
  printf 'noted to %s (%s)\n' "$to_name" "${peer:-closed}"
  exit 0
fi

if [ "$notice" -eq 1 ]; then
  body="$(notice_body "$me" "$msg" "$(pane_name "$peer")" "$message_id")"
elif [ "$reply" -eq 1 ]; then
  body="$(reply_body "$me" "$msg" "$(pane_name "$peer")" "$message_id")"
else
  body="$(request_body "$me" "$msg" "$(pane_name "$peer")" "$([ "$any" -eq 1 ] && printf '%s' '--any ')" "$to_id" "$message_id")"
fi

# Persist even immediate sends, so a failed paste cannot lose the body.
kind=request
[ "$reply" -eq 0 ] || kind=reply
[ "$notice" -eq 0 ] || kind=notice
from_id="$(pane_agent_id "$self")" to_id="$(pane_agent_id "$peer")"
from_pane="$self" from_name="$me" to_pane="$peer" to_name="$(pane_name "$peer")" queued_at="$(date +%s)"
publish "$body"
queued=0
if ! try_delivery "$peer" "$file"; then
  start_deliverer "$peer" "$file" || printf 'delivery worker could not start; message retained at %s\n' "$file" >&2
  queued=1
fi

if [ "$queued" -eq 1 ]; then
  printf 'queued %s to %s: the user is typing or scrolling there; it will be delivered once they stop\n' "$kind" "$(label "$peer")"
else
  printf 'sent %s to %s\n' "$kind" "$(label "$peer")"
fi
