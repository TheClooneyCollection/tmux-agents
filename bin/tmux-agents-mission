#!/usr/bin/env bash
# Project mission records, independent of a running tmux server.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
. "$here/lib.sh"
usage() {
  cat <<'HELP'
usage: tmux-agents mission COMMAND [--from ME] [arguments]
  add TITLE [--owner NAME] [--status S] [--branch B] [--worktree W]
  set ID [--title T] [--owner N] [--status S] [--branch B] [--worktree W]
         [--notify PEER [--notice]]
  done ID TEXT [--notify NAME]
  log ID TEXT [--kind progress|decision|handoff|done]
  show ID [--log N]
  list [--all] [--tsv]
Statuses: design, plan-ready, active, needs-decision, ready-to-push, done.
TSV columns: id, status, owner, title, branch, worktree, created, updated.
Put --from and all options before -- when a title/text starts with --.
A busy .lock is retried for two seconds, then refused; remove a stale lock only after verifying no writer remains.
HELP
}
valid_value() {
  case "$1" in *$'\t'*|*$'\n'*|*$'\r'*) die 'values must not contain tab, LF or CR' ;; esac
}
case "${1:-}" in -h|--help) usage; exit 0 ;; esac
command="${1:-}"; [ "$#" -gt 0 ] || die 'mission command required'; shift
case "$command" in add|set|done|log|show|list) ;; *) die 'unknown mission command' ;; esac
from='' notify='' notice=0 kind=progress count=5 all=0 tsv=0
args=() keys=() values=()
while [ "$#" -gt 0 ]; do
  valid_value "$1"
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --from|--title|--owner|--status|--branch|--worktree|--kind|--log|--notify)
      option="$1"; [ "$#" -ge 2 ] || die "missing value for $option"
      valid_value "$2"
      case "$option" in
        --from) from="$2" ;;
        --notify) case "$command" in set|done) ;; *) die '--notify requires set or done' ;; esac; [ -n "$2" ] || die '--notify needs a name'; notify="$2" ;;
        --kind) [ "$command" = log ] || die '--kind requires log'; kind="$2" ;;
        --log) [ "$command" = show ] || die '--log requires show'; count="$2" ;;
        *) case "$command:$option" in set:*|add:--owner|add:--status|add:--branch|add:--worktree) ;; *) die "invalid option $option" ;; esac
           keys+=("${option#--}"); values+=("$2") ;;
      esac
      shift 2 ;;
    --notice) [ "$command" = set ] || die '--notice requires set'; notice=1; shift ;;
    --all|--tsv)
      [ "$command" = list ] || die "$1 requires list"
      case "$1" in --all) all=1 ;; --tsv) tsv=1 ;; esac; shift ;;
    --) shift; while [ "$#" -gt 0 ]; do valid_value "$1"; args+=("$1"); shift; done ;;
    --*) die 'unknown mission option' ;;
    *) args+=("$1"); shift ;;
  esac
done
[ "$notice" = 0 ] || [ -n "$notify" ] || die '--notice requires --notify'
if [ -n "$notify" ] && [ "$command" = set ]; then
  has_status=0
  for key in "${keys[@]+"${keys[@]}"}"; do [ "$key" != status ] || has_status=1; done
  [ "$has_status" = 1 ] || die '--notify requires --status'
fi
case "$kind" in progress|decision|handoff|done) ;; *) die 'unknown log kind' ;; esac
case "$count" in ''|*[!0-9]*) die '--log must be a nonnegative integer' ;; esac
for ((i=0; i<${#keys[@]}; i++)); do
  case "${keys[i]}" in title|owner) [ -n "${values[i]}" ] || die "${keys[i]} must not be empty" ;; esac
  if [ "${keys[i]}" = status ]; then
    case "${values[i]}" in design|plan-ready|active|needs-decision|ready-to-push|done) ;; *) die 'unknown mission status' ;; esac
  fi
done
case "$command:${#args[@]}" in add:1|set:1|done:2|log:2|show:1|list:0) ;; *) die 'wrong number of mission arguments' ;; esac
case "$command" in
  add) [ -n "${args[0]}" ] || die 'title must not be empty' ;;
  log|done) [ -n "${args[1]}" ] || die 'log text must not be empty' ;;
  set) [ "${#keys[@]}" -gt 0 ] || die 'set requires at least one field' ;;
esac
if [ -z "$from" ]; then
  trusted_pane || die 'untrusted pane: pass --from ME'
  require_tmux
  FROM_PANE=''
  from="$(pane_name "$(self_pane)")"
  [ -n "$from" ] || die 'this pane has no name; pass --from ME'
fi
dir="$(mission_directory)"
file='' tmp='' locked=0
# Invoked by traps.
# shellcheck disable=SC2329
cleanup() {
  [ -z "$tmp" ] || rm -f "$tmp"
  if [ "$locked" = 1 ]; then rmdir "$dir/.lock"; fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
case "$command" in
  add|set|done|log)
    mkdir -p "$dir" || die 'cannot create mission directory'
    attempts=0
    until mkdir "$dir/.lock" 2>/dev/null; do
      [ "$attempts" -lt 20 ] || die 'mission directory locked after retries (busy or stale .lock)'
      sleep 0.1
      attempts=$((attempts + 1))
    done
    locked=1 ;;
esac
if [ "$command" != add ] && [ "$command" != list ]; then
  id="${args[0]}"
  case "$id" in M[1-9]*) case "${id#M}" in *[!0-9]*) die 'unknown mission ID' ;; esac ;; *) die 'unknown mission ID' ;; esac
  file="$dir/$id.mission"
  [ -f "$file" ] || die 'unknown mission ID'
fi
get() { awk -F= -v key="$1" '$1 == key {sub(/^[^=]*=/, ""); value=$0} END {printf "%s", value}' "$file"; }
# Rewrite only named fields; preserve unknown keys and literal backslashes.
write_record() {
  local line key j k replaced
  tmp="$(mktemp "$dir/.mission.XXXXXX")" || die 'cannot create temporary record'
  if [ -n "$file" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      key="${line%%=*}"; replaced=0
      for ((j=0; j<${#keys[@]}; j++)); do [ "$key" != "${keys[j]}" ] || replaced=1; done
      [ "$replaced" = 1 ] || printf '%s\n' "$line"
    done < "$file" > "$tmp"
  fi
  for ((j=0; j<${#keys[@]}; j++)); do
    replaced=0
    for ((k=j+1; k<${#keys[@]}; k++)); do [ "${keys[j]}" != "${keys[k]}" ] || replaced=1; done
    [ "$replaced" = 1 ] || printf '%s=%s\n' "${keys[j]}" "${values[j]}"
  done >> "$tmp"
  mv "$tmp" "$dir/$id.mission" || die 'cannot publish mission record'
  tmp=''
}
case "$command" in
  add)
    next=0
    for record in "$dir"/M*.mission "$dir"/M*.log; do
      number="${record##*/M}"; number="${number%.*}"
      case "$number" in ''|*[!0-9]*|0*) continue ;; esac
      [ "$number" -le "$next" ] || next="$number"
    done
    id="M$((next + 1))"; now="$(date +%s)"
    keys=(id title owner status created updated ${keys[@]+"${keys[@]}"})
    values=("$id" "${args[0]}" "$from" design "$now" "$now" ${values[@]+"${values[@]}"})
    write_record
    printf '%s\n' "$id" ;;
  set|done|log)
    if [ "$command" = 'done' ]; then keys+=(status); values+=('done'); fi
    now="$(date +%s)"; old_status="$(get status)"; new_status="$old_status"
    for ((i=0; i<${#keys[@]}; i++)); do
      [ "${keys[i]}" != status ] || new_status="${values[i]}"
    done
    keys+=(updated); values+=("$now")
    write_record
    if [ "$command" = log ] || [ "$command" = 'done' ]; then
      [ "$command" != 'done' ] || kind='done'
      printf '%s\t%s\t%s\t%s\n' "$now" "$from" "$kind" "${args[1]}" >> "$dir/$id.log"
    elif [ "$old_status" != "$new_status" ]; then
      printf '%s\t%s\tprogress\tstatus: %s -> %s\n' "$now" "$from" "$old_status" "$new_status" >> "$dir/$id.log"
    fi ;;
  show)
    cat "$file"
    if [ -f "$dir/$id.log" ]; then tail -n "$count" "$dir/$id.log"; fi ;;
  list)
    for file in "$dir"/M*.mission; do
      [ -f "$file" ] || continue
      status="$(get status)"; [ "$all" = 1 ] || [ "$status" != "done" ] || continue
      if [ "$tsv" = 1 ]; then
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(get id)" "$status" "$(get owner)" "$(get title)" "$(get branch)" "$(get worktree)" "$(get created)" "$(get updated)"
      else
        printf '%s  %s  %s  %s\n' "$(get id)" "$status" "$(get owner)" "$(get title)"
      fi
    done | sort -k1.2,1n ;;
esac

# Release the record lock before delivery, which may itself write mission logs.
if [ -n "$notify" ]; then
  rmdir "$dir/.lock"; locked=0
  text="$id status: $old_status -> $new_status"
  [ "$command" != 'done' ] || text="$id done: ${args[1]}"
  mode=--note
  [ "$notice" = 0 ] || mode=--notice
  "$here/tmux-ask" --from "$from" "$mode" "$notify" "$text" ||
    die "mission saved, but notification to '$notify' failed; retry the notification only"
fi
