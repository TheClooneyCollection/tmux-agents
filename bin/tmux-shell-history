#!/bin/sh
# Check Python before starting the picker: Apple's launcher can open an installer.
fail_python() {
  printf 'tmux-shell-history: %s\n' "$1" >&2
  shift
  for arg do
    if [ "$arg" = --pick ] && [ -t 0 ] && [ -t 2 ]; then
      printf 'Press Enter to close. ' >&2
      IFS= read -r _answer || :
      break
    fi
  done
  exit 127
}

python=$(command -v python3) || python=
[ -n "$python" ] || fail_python 'Python 3 is required; install Python 3 and try again.' "$@"
# -ef also catches symlinks and hard links to the Apple stub. xcode-select -p
# only reads the selected developer directory; never execute the stub or xcrun.
if [ "$python" -ef /usr/bin/python3 ] && [ -x /usr/bin/xcode-select ]; then
  developer=$(/usr/bin/xcode-select -p 2>/dev/null) || developer=
  real_python=$developer/usr/bin/python3
  if [ -z "$developer" ] || [ ! -x "$real_python" ] || [ "$real_python" -ef /usr/bin/python3 ]; then
    fail_python 'Python 3 is unavailable: Apple Command Line Tools are missing. Install Python 3 or the Command Line Tools, then try again.' "$@"
  fi
  python=$real_python
fi
here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
exec "$python" "$here/tmux-shell-history.py" "$@"
